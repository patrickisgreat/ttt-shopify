      "type": "faq-with-image",
      "blocks": {
        "faq_item_kw7Xec": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need any experience?",
            "answer": "<p>None at all. The app guides you through every step, one line at a time. If you can follow numbers, you can make a Threaditate.</p>"
          }
        },
        "faq_item_D8zJqt": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use any photo?",
            "answer": "<p>Yes, although some photos look better than others. Try lots! Crisp portraits and close-ups with clear contrast and plain backgrounds come out best, since the app reads light and shadow. We built a menu stacked with editing features to fine tune your masterpiece. Make it just right, then begin</p>"
          }
        },
        "faq_item_JTeLJB": {
          "type": "faq_item",
          "settings": {
            "question": "How long does it take?",
            "answer": "<p>Most pieces take about six hours, depending on the line count. The app saves your place after every line, so you can take breaks and go at your own pace.</p>"
          }
        },
        "faq_item_FBchyJ": {
          "type": "faq_item",
          "settings": {
            "question": "What if I make a mistake?",
            "answer": "<p>Forget it and just keep going. If you lose your place, just continue with the next step. Countless mistakes blend right into the finished piece, so there is no need to hit the back button ever.</p>"
          }
        }
      },
