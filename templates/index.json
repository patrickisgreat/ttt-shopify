    "faq_with_image_pJeM3D": {
      "type": "faq-with-image",
      "blocks": {
        "faq_item_Thbefr": {
          "type": "faq_item",
          "settings": {
            "question": "Will my photo actually turn out good?",
            "answer": "<p>Yes - a clear photo with a close-up subject in good contrast makes a strong piece. Faces, pets, and simple compositions work beautifully.</p>"
          }
        },
        "faq_item_jPDegj": {
          "type": "faq_item",
          "settings": {
            "question": "How does this actually work?",
            "answer": "<p>Upload a photo and the app turns it into a numbered sequence. It speaks aloud and shows each step, then flows to the next at whatever pace you set - line by line until you're done. You can tap to advance, or autoplay.</p>"
          }
        },
        "faq_item_3wGpVc": {
          "type": "faq_item",
          "settings": {
            "question": "Be honest… is Threaditate hard?",
            "answer": "<p>No, it's easy. If you can count to 240, you can Threaditate. The app accounts for everything else.</p>"
          }
        },
        "faq_item_3eyjFJ": {
          "type": "faq_item",
          "settings": {
            "question": "How long does it take to make?",
            "answer": "<p>Most pieces take 6 hours, but can be finished in 5 or take 8, depending on detail. Plenty of makers spread that across a few evenings. The app saves your place - it's ready whenever you are. You deserve moments of calm, take as many as often as you'd like.</p>"
          }
        },
        "faq_item_fThdwz": {
          "type": "faq_item",
          "settings": {
            "question": "What exactly do I get?",
            "answer": "<p>The loom, thread, spool holder, precision wand, numbered paper guide, wooden phone stand, mounting accessories, the easel-box, and app access - no subscription ever.</p>"
          }
        }
      },
