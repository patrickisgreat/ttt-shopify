    "faq_with_image_pJeM3D": {
      "type": "faq-with-image",
      "blocks": {
        "faq_item_Thbefr": {
          "type": "faq_item",
          "settings": {
            "question": "Will my photo actually turn out good?",
            "answer": "<p>Yes, as long as your photo is clear and the subject stands out, you’ll get a strong result. Faces, pets, and simple compositions work best.</p>"
          }
        },
        "faq_item_jPDegj": {
          "type": "faq_item",
          "settings": {
            "question": "How does this actually work?",
            "answer": "<p>Upload your photo, and we turn it into a custom string pattern. You’ll get a kit with everything you need. Just follow the guide and connect the thread to bring your image to life.</p>"
          }
        },
        "faq_item_3wGpVc": {
          "type": "faq_item",
          "settings": {
            "question": "Be honest…is Threaditate hard?",
            "answer": "<p>Not really. It might look intimidating at first, but it’s designed for beginners. If you can follow a step-by-step guide, you can definitely do this. Most people get the hang of it pretty quickly.</p>"
          }
        },
        "faq_item_3eyjFJ": {
          "type": "faq_item",
          "settings": {
            "question": "How long does it take to make?",
            "answer": "<p>Most pieces take around 4–8 hours, depending on size and detail. Some people finish it in one sitting, others spread it out over a few nights.</p>"
          }
        },
        "faq_item_fThdwz": {
          "type": "faq_item",
          "settings": {
            "question": "What exactly do I get?",
            "answer": "<p>Everything you need: a pre-nailed board, thread, your custom pattern, and the tools to complete it. No extra trips to the store required.</p>"
          }
        }
      },
