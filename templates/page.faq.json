        "q_what_is": {
          "type": "faq_item",
          "settings": {
            "question": "What is Threaditate?",
            "answer": "<p>Threaditate turns a photo you love into string art you make by hand. You upload the photo to the app, it creates a numbered pattern, and you follow that pattern thread by thread on a 20-inch loom until your picture appears. No experience needed, and everything you need comes in the kit.</p>"
          }
        },
        "q_any_photo": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use any photo?",
            "answer": "<p>Almost any photo works. Portraits and close-ups with clear contrast tend to come out best, since the loom reads light and shadow rather than fine detail. A favorite person, a pet, a place that means something to you. Upload it, and the app does the rest.</p>"
          }
        },
        "q_experience": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need any experience?",
            "answer": "<p>None at all. The app walks you through every step, one thread at a time, so there's nothing to figure out on your own. If you can follow numbers, you can make a Threaditate.</p>"
          }
        },
        "topic_the_kit": {
