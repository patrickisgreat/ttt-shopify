          }
        },
        "q_photo_privacy": {
          "type": "faq_item",
          "settings": {
            "question": "What happens to my photo?",
            "answer": "<p>Your photo is used only to create your pattern. We never share it.  It self-deletes after 90 days since last opened.</p>"
          }
        },
        "q_buy_finished": {
          "type": "faq_item",
          "settings": {
            "question": "Can I buy a finished piece instead of making it myself?",
            "answer": "<p>No, but you can gift kits to friends and request that they make you custom designs! Threaditate is about the making. The quiet hours you spend creating something by hand are the whole point, so we don't sell finished pieces. We give you the means to make your own.</p>"
          }
