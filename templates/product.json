        "75b14a74-c1c5-4fcc-932f-e2bfa017fba2": {
          "type": "collapsible_tab",
          "settings": {
            "title": "Features",
            "content": "<ul><li><strong>Real-time voice-guided app</strong> — speaks and shows each step, then flows to the next at your pace. No lost lines, no buttons between them.</li><li><strong>Convertible easel-box</strong> — packaging that becomes your work surface.</li><li><strong>Wooden phone stand</strong> — holds your guide hands-free while you thread.</li><li><strong>Thread and spool holder</strong> — pre-cut, organized, ready to use.</li><li><strong>Precision threading wand</strong> — designed for clean, accurate placement.</li><li><strong>Numbered paper guide</strong> — a physical reference for using the loom with our app.</li><li><strong>Patented software and loom design</strong> — U.S. Patent 12,423,349. An original system you won't find anywhere else.</li></ul>",
            "page": "",
            "open_as_drawer": false,
            "icon": "icon-caret__right",
            "margin_top": 24
          }
        },
        "cb99c690-44cf-4273-8519-6e54272edcba": {
          "type": "collapsible_tab",
          "settings": {
            "title": "Benefits",
            "content": "<ul><li><strong>Your hands know what to do next</strong> — the app speaks each step in real time, from the first line to the last.</li><li><strong>It keeps your pace</strong> — the guide flows on a rhythm you set. Speed up as your hands learn; slow down to sink in.</li><li><strong>The finished piece is yours</strong> — every Threaditate starts from a photo you uploaded. It can't exist anywhere else.</li><li><strong>You will finish this</strong> — the process is designed around completion. The app saves your place, and every session picks up exactly where you left off.</li><li><strong>No experience needed</strong> — the app accounts for that; zero crafting background required.</li><li><strong>Nothing missing from the box</strong> — the kit ships complete: loom, thread, tools, phone stand, easel box, and app access.</li><li><strong>Hands busy, mind quiet</strong> — the kind of focus screens don't provide.</li><li><strong>It makes a real gift</strong> — a completed Threaditate made from a meaningful photo says more than anything off a shelf.</li></ul>",
            "page": "",
            "open_as_drawer": false,
            "icon": "icon-caret__right",
            "margin_top": 0
          }
        },
        "collapsible_tab_GJhtdP": {
          "type": "collapsible_tab",
          "settings": {
            "title": "Specs",
            "content": "<p><strong>Loom</strong></p><ul><li>Diameter: 20\"</li><li>Patent-pending loom design</li><li>Interlocking modular pieces</li><li>Tool-free</li><li>Easel- or wall-mounted</li></ul><p><strong>Thread</strong></p><ul><li>Pre-cut thread set</li><li>Integrated spool holder included</li></ul><p><strong>Tools included</strong></p><ul><li>Precision threading wand</li><li>Numbered paper guide</li><li>Wooden phone stand</li></ul><p><strong>Packaging</strong></p><ul><li>Mailbox-sized box converts to easel work surface</li><li>No additional stand required</li></ul><p><strong>App</strong></p><ul><li>iOS and Android</li><li>Cost: Free (included with kit)</li><li>Features: photo upload, real-time voice-guided session, adjustable pacing, design preview</li><li>U.S. Patent 12,423,349</li></ul><p><strong>Project duration</strong></p><ul><li>Estimated completion: 5–8 hours depending on design complexity</li><li>Session flexibility: pause and resume — the app saves your progress</li></ul>",
            "page": "",
            "open_as_drawer": false,
            "icon": "icon-caret__right",
            "margin_top": 8
          }
        },
        "collapsible_tab_ftBRFa": {
          "type": "collapsible_tab",
          "settings": {
            "title": "Shipping & Returns",
            "content": "<p>Ships from Huntsville, AL within one business day.</p><p>30-day guarantee — if it's not for you, send it back in new condition. Pieces warped by over-tight threading can't be returned, so thread loosely — a drape, not a tug.</p>",
            "page": "",
