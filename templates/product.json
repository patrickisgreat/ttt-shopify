        "75b14a74-c1c5-4fcc-932f-e2bfa017fba2": {
          "type": "collapsible_tab",
          "settings": {
            "title": "Features",
            "content": "<ul><li><strong>Real-Time Guided App</strong> — Free download (iOS &amp; Android). Converts any photo into a numbered, confirmed-step session.</li><li><strong>Photo-to-Pattern Conversion</strong> — Any image, personalized guide generated in seconds. Live preview before you start.</li><li><strong>20\" Interlocking Loom</strong> — Tool-free assembly. Mounts to easel box or wall.</li><li><strong>Step Confirmation Loop</strong> — Each placement is confirmed before the guide advances. No missed strings.</li><li><strong>Convertible Easel Box</strong> — Packaging that becomes your work surface.</li><li><strong>Wooden Phone Stand</strong> — Holds your guide hands-free while you string.</li><li><strong>Full Thread Set with Spool Holder</strong> — Pre-cut, organized, and ready to use.</li><li><strong>Precision Stringing Tool</strong> — Designed for clean, accurate string placement.</li><li><strong>Numbered Paper Template</strong> — Physical reference guide included alongside the app.</li><li><strong>Patent-Pending Software &amp; Loom Design</strong> — An original system you won't find anywhere else.</li></ul>",
            "page": "",
            "open_as_drawer": false,
            "icon": "icon-caret__right",
            "margin_top": 24
          }
        },
        "cb99c690-44cf-4273-8519-6e54272edcba": {
          "type": "collapsible_tab",
          "settings": {
            "title": "Benefits",
            "content": "<ul><li><strong>Your hands know what to do next</strong> — the app provides real-time confirmed guidance from first string to last.</li><li><strong>The finished piece is yours</strong> — every Threaditate starts from a photo you uploaded. It can't exist anywhere else.</li><li><strong>You will finish this</strong> — the process is designed around completion. Every confirmed step is progress.</li><li><strong>No experience needed — the app accounts for that</strong> — zero crafting background required.</li><li><strong>Nothing missing from the box</strong> — the kit ships complete with the loom, thread, tools, phone stand, easel box, and app access.</li><li><strong>The hour resets you</strong> — your hands are occupied, your mind goes quiet. The kind of focus screens don't provide.</li><li><strong>It makes a real gift</strong> — a completed Threaditate made from a meaningful photo says more than anything off a shelf.</li></ul>",
            "page": "",
            "open_as_drawer": false,
            "icon": "icon-caret__right",
            "margin_top": 0
          }
        },
        "collapsible_tab_GJhtdP": {
          "type": "collapsible_tab",
          "settings": {
            "title": "Specs",
            "content": "<p><strong>Loom</strong></p><ul><li>Diameter: 20\"</li><li>Interlocking modular pieces</li><li>Tool-free</li><li>Mounting: Easel box or wall compatible</li><li>U.S. patent pending</li></ul><p><strong>Thread</strong></p><ul><li>Pre-cut string set</li><li>Integrated spool holder included</li></ul><p><strong>Tools Included</strong></p><ul><li>Precision stringing tool</li><li>Numbered paper template</li><li>Wooden phone stand</li><li>Zip ties for assembly</li></ul><p><strong>Packaging</strong></p><ul><li>Mailbox-sized box converts to easel work surface</li><li>No additional stand required</li></ul><p><strong>App</strong></p><ul><li>iOS and Android</li><li>Cost: Free (included with kit)</li><li>Features: Photo upload, real-time guided session, step confirmation loop, design preview</li><li>U.S. patent pending</li></ul><p><strong>Project Duration</strong></p><ul><li>Estimated completion: 3–6 hours depending on design complexity</li><li>Session flexibility: Pause and resume, the app saves progress</li></ul>",
            "page": "",
            "open_as_drawer": false,
            "icon": "icon-caret__right",
            "margin_top": 8
