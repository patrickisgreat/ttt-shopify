        "2ad218b6-4cf8-49f8-a948-4ca131ed654a": {
          "type": "text",
          "settings": {
            "text": "<p>Your hands make it. The app walks you through every step.</p><p>Upload any photo — a face, a pet, a skyline — and the app converts it into a real-time, voice-guided string placement sequence. You confirm each step before the next one appears. No diagrams to decode, no wrong moves to undo. Just you, the thread, and what the app tells you next. Walk away with a finished piece made entirely by your own hands.</p>",
            "read_more": false,
            "margin_top": 24
          }
        },
        "text_tRMRrA": {
          "type": "text",
          "settings": {
            "text": "<p><strong>What's Included: </strong></p><ul><li>20\" Interlocking Loom Pieces</li><li>Pre-Cut String & Spool Holder</li><li>Precision Stringing Tool</li><li>Numbered Paper Template</li><li>Wooden Phone Stand</li><li>Convertible Box Easel</li><li>Zip Ties for Assembly</li><li>App Access for Custom Guides</li></ul>",
            "read_more": true,
