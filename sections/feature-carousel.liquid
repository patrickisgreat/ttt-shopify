{{ 'section-features-carousel.css' | asset_url | stylesheet_tag }}

<div
  id="{{ section.id }}"
  class="features-carousel container pt pb sm-pt sm-pb color-{{ section.settings.color_scheme }}"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>

  <div class="features-carousel__header text-align-center">
    {%- if section.settings.heading != blank -%}
      <h2 class="features-carousel__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="features-carousel__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}

    <div class="features-carousel__stage">
      <div class="features-carousel__track" id="features-carousel-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <div class="features-carousel__slide" {{ block.shopify_attributes }}>
              <div class="features-carousel__image sm-br-img">
                {%- if block.settings.image != blank -%}
                  {%- render 'img',
                    lazyload: true,
                    wrapped: false,
                    src: block.settings.image
                  -%}
                {%- else -%}
                  <div class="features-carousel__placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}
              </div>
              <div class="features-carousel__slide-text">
                {%- if block.settings.title != blank -%}
                  <h3 class="features-carousel__slide-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <p class="features-carousel__slide-caption">{{ block.settings.caption }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="features-carousel__dots" id="features-carousel-dots-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <button
              class="features-carousel__dot{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  {%- endif -%}

</div>

<script>
(function() {
  var track = document.getElementById('features-carousel-track-{{ section.id }}');
  var dotsContainer = document.getElementById('features-carousel-dots-{{ section.id }}');
  if (!track) return;

  var slides = Array.from(track.querySelectorAll('.features-carousel__slide'));
  var dots = dotsContainer ? Array.from(dotsContainer.querySelectorAll('.features-carousel__dot')) : [];
  var current = 0;
  var total = slides.length;

  function getVisibleCount() {
    if (window.innerWidth >= 1024) return 3;
    if (window.innerWidth >= 640)  return 2;
    return 1;
  }

  function getMaxIndex() {
    return Math.max(0, total - getVisibleCount());
  }

  function goTo(index) {
    var max = getMaxIndex();
    current = Math.max(0, Math.min(index, max));

    var slideWidth = slides[0].offsetWidth;
    var gap = parseInt(getComputedStyle(track).gap) || 0;
    track.style.transform = 'translateX(-' + (current * (slideWidth + gap)) + 'px)';

    dots.forEach(function(dot, i) {
      dot.classList.toggle('is-active', i === current);
    });
  }

  dots.forEach(function(dot, i) {
    dot.addEventListener('click', function() { goTo(i); });
  });

  // Touch/swipe support
  var startX = 0;
  track.addEventListener('touchstart', function(e) {
    startX = e.touches[0].clientX;
  }, { passive: true });

  track.addEventListener('touchend', function(e) {
    var diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) {
      goTo(diff > 0 ? current + 1 : current - 1);
    }
  }, { passive: true });

  window.addEventListener('resize', function() { goTo(current); });

  goTo(0);
})();
</script>

{% schema %}
{
  "name": "Features Carousel",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "default",
      "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Features Section"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Lorem ipsum dolor sit amet consectetur adipiscing elit semper dalar elementum tempus hac tellus libero accumsan."
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "name": "Slide",
      "type": "slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square or landscape images recommended."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Header",
          "default": "Header"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption",
          "default": "Lorem ipsum dolor sit amet consectetur adipiscing elit semper dalar elementum tempus hac tellus libero accumsan."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Carousel",
      "category": "Custom",
      "blocks": [
        { "type": "slide", "settings": { "title": "Header" } },
        { "type": "slide", "settings": { "title": "Header" } },
        { "type": "slide", "settings": { "title": "Header" } },
        { "type": "slide", "settings": { "title": "Header" } }
      ]
    }
  ]
}
{% endschema %}