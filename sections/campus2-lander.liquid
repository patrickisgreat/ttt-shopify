{% comment %}
  Threaditate — CAMPUS20 Landing Page
  Reusable ad-to-lander message matching.

  URL examples:
  /pages/campus20?hook=study-break
  /pages/campus20?hook=actually-finish
  /pages/campus20?utm_content=camera-roll

  Hook priority:
  1. ?hook=
  2. ?utm_content=
  3. Default hero copy

  Create CAMPUS20 in Shopify Admin > Discounts.
{% endcomment %}

{% liquid
  assign promo_code = section.settings.discount_code | strip

  if section.settings.product != blank
    assign cta_path = section.settings.product.url
  else
    assign cta_path = routes.all_products_collection_url
  endif

  assign cta_url = cta_path

  if promo_code != blank
    assign cta_url = '/discount/' | append: promo_code | append: '?redirect=' | append: cta_path
  endif
%}

<section
  id="Campus20-{{ section.id }}"
  class="campus20"
  data-campus20-section
>

  {% if section.settings.hide_theme_chrome %}
    <script>
      document.documentElement.classList.add('threaditate-lander-active');
    </script>
  {% endif %}

  {%- comment -%}
    ============================================================
    ANNOUNCEMENT
    ============================================================
  {%- endcomment -%}

  <div class="campus20__announcement">
    <div class="campus20__shell campus20__announcement-inner">
      <span>{{ section.settings.announcement }}</span>

      {% if promo_code != blank %}
        <button
          class="campus20__code-button"
          type="button"
          data-copy-code="{{ promo_code | escape }}"
          aria-label="Copy discount code {{ promo_code }}"
        >
          {{ promo_code }}
          <span class="campus20__copy-label" data-copy-label>copy</span>
        </button>
      {% endif %}
    </div>
  </div>


  {%- comment -%}
    ============================================================
    HERO
    ============================================================
  {%- endcomment -%}

  <div class="campus20__hero">
    <div class="campus20__hero-grid campus20__shell">

      <div class="campus20__hero-copy">
        <p class="campus20__eyebrow" data-hook-eyebrow>
          {{ section.settings.hero_eyebrow }}
        </p>

        <h1 class="campus20__h1" data-hook-headline>
          {{ section.settings.hero_headline }}
        </h1>

        <p class="campus20__hero-subhead" data-hook-subhead>
          {{ section.settings.hero_subhead }}
        </p>

        <div class="campus20__hero-actions">
          <a
            class="campus20__button campus20__button--primary"
            href="{{ cta_url }}"
            data-campus-cta
          >
            {{ section.settings.cta_label }}
            <span aria-hidden="true">→</span>
          </a>

          {% if promo_code != blank %}
            <p class="campus20__offer-note">
              Use code <strong>{{ promo_code }}</strong> for
              {{ section.settings.discount_amount }} at checkout.
            </p>
          {% endif %}
        </div>

        <div class="campus20__micro-proof">
          <span>App included</span>
          <span aria-hidden="true">·</span>
          <span>No subscription</span>
          <span aria-hidden="true">·</span>
          <span>No experience needed</span>
        </div>
      </div>


      <div class="campus20__hero-media">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              class: 'campus20__hero-image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600, 900, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.hero_image.alt
          }}
        {% else %}
          <div class="campus20__placeholder campus20__placeholder--hero">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
            <span>Select your campus hero image</span>
          </div>
        {% endif %}

        <div class="campus20__hero-card">
          <span>Campus gets</span>
          <strong>20% off</strong>
          <small>{{ promo_code }}</small>
        </div>
      </div>

    </div>
  </div>


  {%- comment -%}
    Hidden hook data.
    JS below message-matches hero to ?hook= or ?utm_content=
  {%- endcomment -%}

  <div hidden data-hook-library>
    {% for block in section.blocks %}
      {% if block.type == 'hook' %}
        <span
          data-hook-record
          data-key="{{ block.settings.key | handleize }}"
          data-eyebrow="{{ block.settings.eyebrow | escape }}"
          data-headline="{{ block.settings.headline | escape }}"
          data-subhead="{{ block.settings.subhead | escape }}"
          {{ block.shopify_attributes }}
        ></span>
      {% endif %}
    {% endfor %}
  </div>


  {%- comment -%}
    ============================================================
    PROOF STRIP
    ============================================================
  {%- endcomment -%}

  <div class="campus20__proof">
    <div class="campus20__proof-grid campus20__shell">

      <div class="campus20__proof-item">
        <strong>2,035</strong>
        <span>Kickstarter backers</span>
      </div>

      <div class="campus20__proof-item">
        <strong>$172,797</strong>
        <span>raised</span>
      </div>

      <div class="campus20__proof-item">
        <strong>Voice-guided</strong>
        <span>app included</span>
      </div>

      <div class="campus20__proof-item">
        <strong>Built</strong>
        <span>to be finished</span>
      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    SOCIAL PROOF
    ============================================================
  {%- endcomment -%}

  <div class="campus20__section campus20__section--ivory">
    <div class="campus20__shell campus20__narrow">

      <p class="campus20__eyebrow">Made by people like you</p>

      <div class="campus20__quotes">

        <figure class="campus20__quote campus20__quote--featured">
          <blockquote>
            “I actually finished something. Every other craft I’ve tried
            ends up in a drawer. This one’s hanging on my wall.”
          </blockquote>
          <figcaption>Derek P. · Kickstarter backer</figcaption>
        </figure>

        <figure class="campus20__quote">
          <blockquote>
            “I sat down to do one session and looked up three hours later.”
          </blockquote>
          <figcaption>Marisa T. · Kickstarter backer</figcaption>
        </figure>

      </div>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    EXPERIENCE
    ============================================================
  {%- endcomment -%}

  <div class="campus20__section campus20__section--blue">

    <div class="campus20__shell campus20__split">

      <div class="campus20__media-card">
        {% if section.settings.process_image != blank %}
          {{
            section.settings.process_image
            | image_url: width: 1500
            | image_tag:
              class: 'campus20__process-image',
              loading: 'lazy',
              widths: '500, 800, 1100, 1500',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: section.settings.process_image.alt
          }}
        {% else %}
          <div class="campus20__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag }}
            <span>Select a close-up threading image</span>
          </div>
        {% endif %}
      </div>


      <div class="campus20__section-copy campus20__section-copy--light">

        <p class="campus20__eyebrow campus20__eyebrow--light">
          A different kind of break
        </p>

        <h2 class="campus20__h2">
          Give your brain something else to do.
        </h2>

        <p class="campus20__lead">
          Put on music. Start an audiobook. Let the app read the next
          number aloud.
        </p>

        <p>
          Your hands find the rhythm while a photo you care about slowly
          becomes art.
        </p>

        <div class="campus20__mini-grid">

          <div>
            <span class="campus20__mini-number">01</span>
            <h3>Screen-optional</h3>
            <p>
              The app speaks each step aloud, so your eyes can stay on
              the loom.
            </p>
          </div>

          <div>
            <span class="campus20__mini-number">02</span>
            <h3>Made to finish</h3>
            <p>
              Pause whenever you want. Your place is saved for the next
              session.
            </p>
          </div>

          <div>
            <span class="campus20__mini-number">03</span>
            <h3>Personal from the start</h3>
            <p>
              Upload a photo that matters to you. Your piece begins there.
            </p>
          </div>

        </div>

        <a
          class="campus20__button campus20__button--ivory"
          href="{{ cta_url }}"
          data-campus-cta
        >
          {{ section.settings.cta_label }}
          <span aria-hidden="true">→</span>
        </a>

      </div>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    ANY PHOTO / GALLERY
    ============================================================
  {%- endcomment -%}

  <div class="campus20__section campus20__section--ivory">

    <div class="campus20__shell">

      <div class="campus20__section-heading campus20__section-heading--center">
        <p class="campus20__eyebrow">Any meaningful photo</p>

        <h2 class="campus20__h2">
          Your roommate. Your dog. Your person.
        </h2>

        <p>
          Your hometown. Your family. The trip you still talk about.
          The photo that's been sitting in your camera roll for three years.
        </p>
      </div>


      <div class="campus20__gallery">

        <figure class="campus20__gallery-card">
          {% if section.settings.gallery_image_1 != blank %}
            {{
              section.settings.gallery_image_1
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '400, 700, 1000',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: section.settings.gallery_image_1.alt
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}
          <figcaption>the people you found here</figcaption>
        </figure>


        <figure class="campus20__gallery-card">
          {% if section.settings.gallery_image_2 != blank %}
            {{
              section.settings.gallery_image_2
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '400, 700, 1000',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: section.settings.gallery_image_2.alt
            }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {% endif %}
          <figcaption>the ones you miss</figcaption>
        </figure>


        <figure class="campus20__gallery-card">
          {% if section.settings.gallery_image_3 != blank %}
            {{
              section.settings.gallery_image_3
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '400, 700, 1000',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: section.settings.gallery_image_3.alt
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}
          <figcaption>the picture that means something</figcaption>
        </figure>

      </div>


      <div class="campus20__center-action">
        <a
          class="campus20__button campus20__button--primary"
          href="{{ cta_url }}"
          data-campus-cta
        >
          Turn my photo into art
          <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    HOW IT WORKS
    ============================================================
  {%- endcomment -%}

  <div class="campus20__section campus20__section--black">

    <div class="campus20__shell">

      <div class="campus20__section-heading">
        <p class="campus20__eyebrow campus20__eyebrow--blue">
          How it works
        </p>

        <h2 class="campus20__h2 campus20__h2--light">
          From camera roll to wall.
        </h2>
      </div>


      <div class="campus20__steps">

        <article class="campus20__step">
          <span>01</span>
          <h3>Upload your photo</h3>
          <p>Choose the image you actually care about.</p>
        </article>

        <article class="campus20__step">
          <span>02</span>
          <h3>Set up your loom</h3>
          <p>Snap it together, mount it to the easel, and get comfortable.</p>
        </article>

        <article class="campus20__step">
          <span>03</span>
          <h3>Follow along</h3>
          <p>
            The app speaks and shows the sequence line by line at your pace.
          </p>
        </article>

        <article class="campus20__step">
          <span>04</span>
          <h3>Hang what you made</h3>
          <p>Finish with a one-of-a-kind piece made by your own hands.</p>
        </article>

      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    COMPLETION
    ============================================================
  {%- endcomment -%}

  <div class="campus20__section campus20__section--completion">

    <div class="campus20__shell campus20__split campus20__split--reverse">

      <div class="campus20__section-copy">

        <p class="campus20__eyebrow">
          Forgiving by design
        </p>

        <h2 class="campus20__h2">
          Built to reach the last line.
        </h2>

        <p class="campus20__lead">
          Lost your place for a second? Keep going.
        </p>

        <p>
          Thousands of lines create the finished image, so small missed
          steps disappear into the whole. There’s nothing to rip out and redo.
        </p>

        <p>
          When you want to stop, stop. The app saves your progress so the
          next session begins where you left it.
        </p>

        <figure class="campus20__inline-quote">
          <blockquote>
            “I have zero artistic ability. My piece looked like the photo.
            I was shocked.”
          </blockquote>
          <figcaption>James K. · Kickstarter backer</figcaption>
        </figure>

      </div>


      <div class="campus20__media-card">
        {% if section.settings.completion_image != blank %}
          {{
            section.settings.completion_image
            | image_url: width: 1500
            | image_tag:
              class: 'campus20__process-image',
              loading: 'lazy',
              widths: '500, 800, 1100, 1500',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: section.settings.completion_image.alt
          }}
        {% else %}
          <div class="campus20__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag }}
            <span>Select a detailed threading image</span>
          </div>
        {% endif %}
      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    WALL / DORM PAYOFF
    ============================================================
  {%- endcomment -%}

  <div class="campus20__section campus20__section--wall">

    <div class="campus20__wall-overlay"></div>

    {% if section.settings.wall_image != blank %}
      {{
        section.settings.wall_image
        | image_url: width: 2000
        | image_tag:
          class: 'campus20__wall-image',
          loading: 'lazy',
          widths: '700, 1100, 1500, 2000',
          sizes: '100vw',
          alt: section.settings.wall_image.alt
      }}
    {% endif %}

    <div class="campus20__shell campus20__wall-content">

      <p class="campus20__eyebrow campus20__eyebrow--light">
        Handmade by you
      </p>

      <h2 class="campus20__h2 campus20__h2--wall">
        Make the wall feel more like yours.
      </h2>

      <p>
        It started as your photo, passed through your hands, and became
        something nobody else has.
      </p>

      <strong class="campus20__you-made-that">You made that.</strong>

      <a
        class="campus20__button campus20__button--ivory"
        href="{{ cta_url }}"
        data-campus-cta
      >
        {{ section.settings.cta_label }}
        <span aria-hidden="true">→</span>
      </a>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    OFFER
    ============================================================
  {%- endcomment -%}

  <div class="campus20__offer">

    <div class="campus20__shell campus20__offer-inner">

      <p class="campus20__eyebrow campus20__eyebrow--light">
        Campus gets 20% off
      </p>

      <h2 class="campus20__h2 campus20__h2--light">
        Make something between everything else.
      </h2>

      <p class="campus20__offer-copy">
        Your photo. Your hands. A few quiet sessions.
        Something real at the end.
      </p>


      {% if promo_code != blank %}
        <button
          type="button"
          class="campus20__big-code"
          data-copy-code="{{ promo_code | escape }}"
        >
          <span>20% off with</span>
          <strong>{{ promo_code }}</strong>
          <small data-copy-label>tap to copy</small>
        </button>
      {% endif %}


      <a
        class="campus20__button campus20__button--vermillion"
        href="{{ cta_url }}"
        data-campus-cta
      >
        {{ section.settings.cta_label }}
        <span aria-hidden="true">→</span>
      </a>

      <p class="campus20__offer-fine">
        App included. No subscription. Ships within one business day.
        30-day returns.
      </p>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    FAQ
    ============================================================
  {%- endcomment -%}

  <div class="campus20__section campus20__section--ivory">

    <div class="campus20__shell campus20__faq-shell">

      <div class="campus20__section-heading">
        <p class="campus20__eyebrow">Good questions</p>
        <h2 class="campus20__h2">Clear answers.</h2>
      </div>


      <div class="campus20__faq">

        <details>
          <summary>Do I need to know how to make string art?</summary>
          <div>
            <p>
              No experience needed. The app tells you where to go next
              and moves line by line at your pace.
            </p>
          </div>
        </details>

        <details>
          <summary>Can I really use my own photo?</summary>
          <div>
            <p>
              Yes. Upload a person, pet, place, or another meaningful image.
              Clear photos with a close subject and good contrast tend to
              make the strongest pieces.
            </p>
          </div>
        </details>

        <details>
          <summary>How long does one take?</summary>
          <div>
            <p>
              Most pieces take about 5–8 hours depending on your image and
              pace. Spread that across as many sessions as you want.
              The app saves your progress.
            </p>
          </div>
        </details>

        <details>
          <summary>What if I mess up?</summary>
          <div>
            <p>
              Keep going. Threaditate is forgiving by design. Small missed
              steps disappear among the thousands of lines that create
              the finished image.
            </p>
          </div>
        </details>

        <details>
          <summary>Is the app extra?</summary>
          <div>
            <p>
              No. App access comes with the kit, with no subscription.
            </p>
          </div>
        </details>

        <details>
          <summary>What comes with the kit?</summary>
          <div>
            <p>
              Your loom, thread, spool holder, precision threading tool,
              numbered guide, wooden phone stand, convertible easel box,
              mounting accessories, and app access.
            </p>
          </div>
        </details>

      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    FINAL CTA
    ============================================================
  {%- endcomment -%}

  <div class="campus20__final">

    <div class="campus20__shell campus20__final-inner">

      <p>Your camera roll has the picture.</p>

      <h2>Your hands make the art.</h2>

      {% if promo_code != blank %}
        <span>20% off with code {{ promo_code }}</span>
      {% endif %}

      <a
        class="campus20__button campus20__button--primary"
        href="{{ cta_url }}"
        data-campus-cta
      >
        {{ section.settings.cta_label }}
        <span aria-hidden="true">→</span>
      </a>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    MOBILE STICKY CTA
    ============================================================
  {%- endcomment -%}

  <div class="campus20__sticky" data-campus-sticky>
    <div>
      <strong>20% off</strong>
      <span>{{ promo_code }}</span>
    </div>

    <a href="{{ cta_url }}" data-campus-cta>
      {{ section.settings.cta_label }}
      <span aria-hidden="true">→</span>
    </a>
  </div>

</section>


<style>
  #Campus20-{{ section.id }} {
    --tt-cobalt: #1450C4;
    --tt-violet: #3D3DB0;
    --tt-red: #C43D2E;
    --tt-black: #0B0B0F;
    --tt-ivory: #F4F2ED;
    --tt-blue-tint: #8FB2ED;
    --tt-violet-tint: #7C7CD6;
    --tt-red-tint: #F5C2B5;

    --tt-heading:
      var(--font-heading-family, "Space Grotesk", sans-serif);

    --tt-body:
      var(--font-body-family, "DM Sans", sans-serif);

    background: var(--tt-ivory);
    color: var(--tt-black);
    font-family: var(--tt-body);
    font-size: 18px;
    line-height: 1.6;
    overflow: clip;
  }

  #Campus20-{{ section.id }} *,
  #Campus20-{{ section.id }} *::before,
  #Campus20-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #Campus20-{{ section.id }} img {
    display: block;
    width: 100%;
  }

  #Campus20-{{ section.id }} a {
    text-decoration: none;
  }

  #Campus20-{{ section.id }} .campus20__shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  #Campus20-{{ section.id }} .campus20__narrow {
    width: min(920px, calc(100% - 48px));
  }


  /* ---------- announcement ---------- */

  #Campus20-{{ section.id }} .campus20__announcement {
    position: relative;
    z-index: 20;
    background: var(--tt-black);
    color: var(--tt-ivory);
    font-family: var(--tt-heading);
  }

  #Campus20-{{ section.id }} .campus20__announcement-inner {
    min-height: 44px;
    display: flex;
    gap: 14px;
    justify-content: center;
    align-items: center;
    font-size: 13px;
    letter-spacing: .08em;
  }

  #Campus20-{{ section.id }} .campus20__code-button {
    appearance: none;
    border: 1px solid rgba(255,255,255,.35);
    background: transparent;
    color: inherit;
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
    font: inherit;
  }

  #Campus20-{{ section.id }} .campus20__copy-label {
    opacity: .65;
    font-family: var(--tt-body);
    font-size: 10px;
    margin-left: 4px;
  }


  /* ---------- type ---------- */

  #Campus20-{{ section.id }} .campus20__eyebrow {
    margin: 0 0 14px;
    color: var(--tt-red);
    font-family: var(--tt-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #Campus20-{{ section.id }} .campus20__eyebrow--light {
    color: var(--tt-blue-tint);
  }

  #Campus20-{{ section.id }} .campus20__eyebrow--blue {
    color: var(--tt-blue-tint);
  }

  #Campus20-{{ section.id }} .campus20__h1,
  #Campus20-{{ section.id }} .campus20__h2,
  #Campus20-{{ section.id }} .campus20__h2--wall {
    font-family: var(--tt-heading);
    font-weight: 600;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  #Campus20-{{ section.id }} .campus20__h1 {
    margin: 0;
    font-size: clamp(42px, 5.7vw, 78px);
    line-height: .98;
    max-width: 750px;
  }

  #Campus20-{{ section.id }} .campus20__h2 {
    margin: 0;
    font-size: clamp(36px, 4.6vw, 62px);
    line-height: 1.02;
  }

  #Campus20-{{ section.id }} .campus20__h2--light {
    color: var(--tt-ivory);
  }

  #Campus20-{{ section.id }} .campus20__lead {
