      min-height: 62px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 8px 8px 8px 16px;
      background: var(--tt-black);
      color: #fff;
      border-radius: 999px;
      box-shadow: 0 12px 45px rgba(0,0,0,.28);
      transform: translateY(120%);
      transition: transform .3s ease;
    }

    #Campus20-{{ section.id }} .campus20__sticky.is-visible {
      transform: translateY(0);
    }

    #Campus20-{{ section.id }} .campus20__sticky > div {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

    #Campus20-{{ section.id }} .campus20__sticky strong {
      font-family: var(--tt-heading);
      font-size: 13px;
    }

    #Campus20-{{ section.id }} .campus20__sticky span {
      font-size: 10px;
      opacity: .7;
    }

    #Campus20-{{ section.id }} .campus20__sticky > a {
      min-height: 46px;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 0 18px;
      border-radius: 999px;
      background: var(--tt-red);
      color: #fff;
      font-family: var(--tt-heading);
      font-size: 13px;
      font-weight: 600;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    #Campus20-{{ section.id }} *,
    #Campus20-{{ section.id }} *::before,
    #Campus20-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }
</style>


<script>
  (() => {
    const section = document.querySelector('#Campus20-{{ section.id }}');

    if (!section) return;


    /* ---------------------------------
       Ad hook → hero message matching
    --------------------------------- */

    const params = new URLSearchParams(window.location.search);

    const incomingHook =
      params.get('hook') ||
      params.get('utm_content') ||
      '';

    const normalize = (value) => {
      return decodeURIComponent(value || '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    };

    const hookKey = normalize(incomingHook);

    if (hookKey) {
      const records = section.querySelectorAll('[data-hook-record]');

      for (const record of records) {
        if (normalize(record.dataset.key) === hookKey) {
          const eyebrow = section.querySelector('[data-hook-eyebrow]');
          const headline = section.querySelector('[data-hook-headline]');
          const subhead = section.querySelector('[data-hook-subhead]');

          if (eyebrow && record.dataset.eyebrow) {
            eyebrow.textContent = record.dataset.eyebrow;
          }

          if (headline && record.dataset.headline) {
            headline.textContent = record.dataset.headline;
          }

          if (subhead && record.dataset.subhead) {
            subhead.textContent = record.dataset.subhead;
          }

          section.dataset.activeHook = hookKey;

          window.dispatchEvent(
            new CustomEvent('threaditate:hook-applied', {
              detail: {
                hook: hookKey
              }
            })
          );

          break;
        }
      }
    }


    /* ---------------------------------
       Discount code copy
    --------------------------------- */

    section.querySelectorAll('[data-copy-code]').forEach((button) => {
      button.addEventListener('click', async () => {
        const code = button.dataset.copyCode;

        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);

          const label = button.querySelector('[data-copy-label]');

          if (label) {
            const original = label.textContent;
            label.textContent = 'copied';

            window.setTimeout(() => {
              label.textContent = original;
            }, 1800);
          }
        } catch (error) {
          console.warn('Could not copy discount code.', error);
        }
      });
    });


    /* ---------------------------------
       Mobile sticky CTA
    --------------------------------- */

    const sticky = section.querySelector('[data-campus-sticky]');
    const hero = section.querySelector('.campus20__hero');

    if (sticky && hero && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          sticky.classList.toggle('is-visible', !entry.isIntersecting);
        },
        {
          threshold: 0.05
        }
      );

      observer.observe(hero);
    }


    /* ---------------------------------
       CTA tracking event
       Easy hook for GA4 / GTM / Elevar
    --------------------------------- */

    section.querySelectorAll('[data-campus-cta]').forEach((cta) => {
      cta.addEventListener('click', () => {
        window.dispatchEvent(
          new CustomEvent('threaditate:campus-cta', {
            detail: {
              hook: section.dataset.activeHook || 'default',
              promo: '{{ promo_code | escape }}'
            }
          })
        );
      });
    });

  })();
</script>


