{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

<div
  id="{{ section.id }}"
  class="how-it-works-section color-{{ section.settings.color_scheme }}"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>
  <div class="how-it-works__bg-gradient" aria-hidden="true"></div>

  <div class="how-it-works__inner container pt pb sm-pt sm-pb">

    <div class="how-it-works__header text-align-center">
      {%- if section.settings.heading != blank -%}
        <h2 class="how-it-works__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="how-it-works__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="how-it-works__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div class="how-it-works__card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="how-it-works__card-image">
                  {%- render 'img',
                    lazyload: true,
                    wrapped: false,
                    src: block.settings.image
                  -%}
                </div>
              {%- else -%}
                <div class="how-it-works__card-image how-it-works__card-image--placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag }}
                </div>
              {%- endif -%}
              <div class="how-it-works__card-body">
                {%- if block.settings.title != blank -%}
                  <h3 class="how-it-works__card-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="how-it-works__card-description">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="how-it-works__cta text-align-center">
        
          <a href="{{ section.settings.button_link | default: '#' }}"
          class="btn{% if section.settings.button_style == 'secondary' %} btn--secondary{% elsif section.settings.button_style == 'link' %} btn--link{% endif %}"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "How It Works",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "default",
      "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "From photo to finished art in a few simple, guided steps."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to Cart →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "name": "Step",
      "type": "step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "1. Upload Your Photo",
          "info": "Include the step number in the title, e.g. \"1. Upload Your Photo\""
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Choose any meaningful image and customize your design in seconds."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "category": "Custom",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "1. Upload Your Photo",
            "description": "Choose any meaningful image and customize your design in seconds."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "2. Mount Your Loom",
            "description": "Assemble loom, mount to easel box or wall for more stability."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "3. Follow the Guide",
            "description": "String by number at your own pace with calming, guided steps."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "4. Display Your Art",
            "description": "Finish with a piece you'll be proud to hang or gift."
          }
        }
      ]
    }
  ]
}
{% endschema %}