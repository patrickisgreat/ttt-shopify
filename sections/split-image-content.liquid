{{ 'section-split-image-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #{{ section.id }} .split-image-content__btn {
    background: {{ section.settings.button_color | default: '#E8622A' }};
  }
{%- endstyle -%}

{%- liquid
  assign product = all_products[section.settings.product]
  assign selected_variant = product.selected_or_first_available_variant
-%}

<div
  id="{{ section.id }}"
  class="split-image-content color-{{ section.settings.color_scheme }}"
  style="
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
  "
>
  <div class="split-image-content__grid{% if section.settings.image_position == 'right' %} split-image-content__grid--reversed{% endif %}">

    {%- comment -%} ── Image column ── {%- endcomment -%}
    <div class="split-image-content__image-col">
      {%- if section.settings.image != blank -%}
        {%- render 'img',
          lazyload: false,
          wrapped: false,
          src: section.settings.image
        -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    {%- comment -%} ── Content column ── {%- endcomment -%}
    <div class="split-image-content__content-col pt pb sm-pt sm-pb">
      <div class="split-image-content__content">

        {%- if section.settings.heading != blank -%}
          <h2 class="split-image-content__title">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <p class="split-image-content__intro">{{ section.settings.intro }}</p>
        {%- endif -%}

        {%- assign has_bullets = false -%}
        {%- for i in (1..10) -%}
          {%- assign bullet_key = 'bullet_' | append: i -%}
          {%- if section.settings[bullet_key] != blank -%}
            {%- assign has_bullets = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_bullets -%}
          <ul class="split-image-content__bullets">
            {%- for i in (1..10) -%}
              {%- assign bullet_key = 'bullet_' | append: i -%}
              {%- if section.settings[bullet_key] != blank -%}
                <li>{{ section.settings[bullet_key] }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="split-image-content__cta">
            {%- if section.settings.product != blank and product != empty -%}
              {%- form 'product', product, id: 'split-atc-form-{{ section.id }}' -%}
                <input type="hidden" name="id" value="{{ selected_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button
                  type="submit"
                  class="split-image-content__btn"
                  {% unless selected_variant.available %}disabled{% endunless %}
                >
                  {{ section.settings.button_label }}
                  <span aria-hidden="true">→</span>
                </button>
              {%- endform -%}
            {%- else -%}
              
               <a href="{{ section.settings.button_link | default: '#' }}"
                class="split-image-content__btn"
              >
                {{ section.settings.button_label }}
                <span aria-hidden="true">→</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Split Image & Content",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "default",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Will fill the full height of the section. Portrait or square images work best."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything You Need, In One Box"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text (bold)",
      "default": "No extra tools. No guesswork. Everything you need to get started is included."
    },
    {
      "type": "header",
      "content": "Bullet points"
    },
    {
      "type": "text",
      "id": "bullet_1",
      "label": "Bullet 1",
      "default": "Interlocking Loom Pieces"
    },
    {
      "type": "text",
      "id": "bullet_2",
      "label": "Bullet 2",
      "default": "Pre-Cut String & Spool Holder"
    },
    {
      "type": "text",
      "id": "bullet_3",
      "label": "Bullet 3",
      "default": "Precision Stringing Tool"
    },
    {
      "type": "text",
      "id": "bullet_4",
      "label": "Bullet 4",
      "default": "Numbered Paper Template"
    },
    {
      "type": "text",
      "id": "bullet_5",
      "label": "Bullet 5",
      "default": "Wooden Phone Stand"
    },
    {
      "type": "text",
      "id": "bullet_6",
      "label": "Bullet 6",
      "default": "Convertible Box Easel"
    },
    {
      "type": "text",
      "id": "bullet_7",
      "label": "Bullet 7",
      "default": "Zip Ties for Assembly"
    },
    {
      "type": "text",
      "id": "bullet_8",
      "label": "Bullet 8",
      "default": "App Access for Custom Guides"
    },
    {
      "type": "text",
      "id": "bullet_9",
      "label": "Bullet 9"
    },
    {
      "type": "text",
      "id": "bullet_10",
      "label": "Bullet 10"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to Cart →"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product (for Add to Cart)",
      "info": "Select a product to enable a real Add to Cart button. Leave empty to use the link below instead."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Fallback button link",
      "info": "Used only if no product is selected above."
    },
    {
      "type": "color",
