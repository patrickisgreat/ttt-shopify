{{ 'section-hero-dark.css' | asset_url | stylesheet_tag }}
{%- if section.settings.image_before != blank and section.settings.image_after != blank -%}
  {{ 'section-before-after.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #{{ section.id }} .hero-dark__btn--primary {
    background: {{ section.settings.primary_button_color | default: '#C43D2E' }};
  }
{%- endstyle -%}

<div
  id="{{ section.id }}"
  class="hero-dark pt pb sm-pt sm-pb"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>
  <div class="hero-dark__bg" aria-hidden="true"></div>

  <div class="hero-dark__inner container">
    <div class="hero-dark__grid">

      {%- comment -%} ── Left: Text ── {%- endcomment -%}
      <div class="hero-dark__text-col">

        {%- if section.settings.heading != blank -%}
          <h1 class="hero-dark__title">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="hero-dark__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- comment -%} Social proof sits above the CTA, where it can still earn the click. {%- endcomment -%}
        {%- if section.settings.proof_line != blank -%}
          <p class="hero-dark__proof">{{ section.settings.proof_line }}</p>
        {%- endif -%}

        <div class="hero-dark__buttons">
          {%- if section.settings.primary_button_label != blank -%}
            
              <a href="{{ section.settings.primary_button_link | default: '#' }}"
              class="hero-dark__btn hero-dark__btn--primary"
            >
              {{ section.settings.primary_button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_button_label != blank -%}
            
             <a href="{{ section.settings.secondary_button_link | default: '#' }}"
              class="hero-dark__btn hero-dark__btn--secondary"
            >
              {{ section.settings.secondary_button_label }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.caption != blank -%}
          <p class="hero-dark__caption">{{ section.settings.caption }}</p>
        {%- endif -%}

      </div>

      {%- comment -%} ── Right: before/after slider, or a single image ── {%- endcomment -%}
      {%- if section.settings.image_before != blank and section.settings.image_after != blank -%}
        <div class="hero-dark__image-col">
          <div class="hero-dark__image hero-dark__image--compare">
            {%- render 'before-after-image-slider', block: section, sizes: '(min-width: 768px) 50vw, 100vw' -%}
          </div>
        </div>
      {%- elsif section.settings.image != blank -%}
        <div class="hero-dark__image-col">
          <div class="hero-dark__image">
            {%- render 'img',
              lazyload: false,
              wrapped: false,
              src: section.settings.image
            -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Dark",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your Photo. Your Art. Your Way."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A calming, hands-on art kit that turns meaningful photos into custom string art — no experience needed."
    },
    {
      "type": "text",
      "id": "proof_line",
      "label": "Proof line (above buttons)",
      "info": "Social proof shown between the subheading and the buttons."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (below buttons)",
      "default": "Beginner-friendly • No experience needed"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Label",
      "default": "Get my kit"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "primary_button_color",
      "label": "Button color",
      "default": "#C43D2E"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (used when no before/after pair is set)",
      "info": "Portrait or square image recommended."
    },
    {
      "type": "header",
      "content": "Before / after slider"
    },
    {
      "type": "paragraph",
      "content": "Set both images to replace the hero image with a drag slider: the customer's photo on the left, the finished piece on the right."
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before (the photo)"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After (the string art)"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Your photo"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "Your string art"
    },
    {
      "type": "color",
      "id": "label_colors",
      "label": "Label text colour",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "Label position",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Slider aspect ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "natural",
          "label": "Natural"
        }
      ]
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Hero Dark",
      "category": "Custom"
    }
  ]
}
{% endschema %}