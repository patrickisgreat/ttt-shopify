{{ 'section-gift-use-cases.css' | asset_url | stylesheet_tag }}

<div
  id="{{ section.id }}"
  class="gift-section container pt pb sm-pt sm-pb color-{{ section.settings.color_scheme }}"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>
  <div class="gift__header text-align-center">
    {%- if section.settings.heading != blank -%}
      <h2 class="gift__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="gift__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="gift__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'use_case' -%}
          <article class="gift__card" {{ block.shopify_attributes }}>
            <div class="gift__image{% if block.settings.image == blank %} gift__image--placeholder{% endif %}">
              {%- if block.settings.image != blank -%}
                {%- render 'img',
                  lazyload: true,
                  wrapped: false,
                  src: block.settings.image,
                  sizes: '(min-width: 768px) 33vw, 100vw'
                -%}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="gift__body">
              {%- if block.settings.eyebrow != blank -%}
                <p class="gift__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="gift__card-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="gift__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.button_label != blank -%}
    <div class="gift__cta text-align-center">
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary">{{ section.settings.button_label | escape }}</a>
      {%- if section.settings.caption != blank -%}
        <p class="gift__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Gift use cases",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "default", "label": "Color scheme" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The gift that is also a few quiet evenings" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Send a kit with their photo already loaded, or give it blank and let them choose the memory." },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Give a kit" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "caption", "label": "Caption under button", "default": "Ships in 1 business day. Gift note at checkout." },
    { "type": "header", "content": "Desktop layout" },
    { "type": "range", "id": "md_padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "md_padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Padding bottom", "default": 80 },
    { "type": "header", "content": "Mobile layout" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "name": "Use case",
      "type": "use_case",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "A finished piece for this occasion. Portrait, 4:5 works best." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For" },
        { "type": "text", "id": "title", "label": "Title", "default": "Grandparents" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A portrait of the person who raised you, made by your own hands." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift use cases",
      "category": "Custom",
      "blocks": [
        { "type": "use_case", "settings": { "eyebrow": "Pet memorials", "title": "The dog who was always there", "text": "Their face in thread, on the wall, made over a few evenings you'll remember." } },
        { "type": "use_case", "settings": { "eyebrow": "Grandparents", "title": "The person who raised you", "text": "A portrait made by your hands says more than anything off a shelf." } },
        { "type": "use_case", "settings": { "eyebrow": "Weddings and anniversaries", "title": "The photo from that day", "text": "Turned into the piece above the bed, by the two of you." } }
      ]
    }
  ]
}
{% endschema %}
