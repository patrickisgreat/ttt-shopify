<script>
  (() => {
    const section = document.querySelector('#LaborDay-{{ section.id }}');
    if (!section) return;


    /* ---------------------------------
       Ad hook → hero message matching
    --------------------------------- */

    const params = new URLSearchParams(window.location.search);
    const incomingHook = params.get('hook') || params.get('utm_content') || '';

    const normalize = (value) =>
      decodeURIComponent(value || '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');

    const hookKey = normalize(incomingHook);

    if (hookKey) {
      for (const record of section.querySelectorAll('[data-hook-record]')) {
        if (normalize(record.dataset.key) !== hookKey) continue;

        const eyebrow = section.querySelector('[data-hook-eyebrow]');
        const headline = section.querySelector('[data-hook-headline]');
        const subhead = section.querySelector('[data-hook-subhead]');

        if (eyebrow && record.dataset.eyebrow) eyebrow.textContent = record.dataset.eyebrow;
        if (headline && record.dataset.headline) headline.textContent = record.dataset.headline;
        if (subhead && record.dataset.subhead) subhead.textContent = record.dataset.subhead;

        section.dataset.activeHook = hookKey;
        window.dispatchEvent(new CustomEvent('threaditate:hook-applied', { detail: { hook: hookKey } }));
        break;
      }
    }


    /* ---------------------------------
       Countdown to sale end
       Reads data-sale-end (ISO 8601 with offset)
    --------------------------------- */

    const saleEnd = Date.parse(section.dataset.saleEnd || '');
    const countdownEls = section.querySelectorAll('[data-countdown], [data-countdown-inline]');

    if (!Number.isNaN(saleEnd) && countdownEls.length) {
      const render = () => {
        const diff = saleEnd - Date.now();

        if (diff <= 0) {
          countdownEls.forEach((el) => { el.hidden = true; });
          return false;
        }

        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);

        const text = d > 0
          ? `${d}d ${h}h ${String(m).padStart(2, '0')}m`
          : `${h}h ${String(m).padStart(2, '0')}m`;

        countdownEls.forEach((el) => {
          const value = el.querySelector('[data-countdown-value]');
          if (value) value.textContent = text;
          el.hidden = false;
        });

        return true;
      };

      if (render()) window.setInterval(render, 30000);
    }


    /* ---------------------------------
       FAQ accordion
       Own toggle, so theme <details> hooks can't swallow clicks
    --------------------------------- */

    section.querySelectorAll('[data-faq-toggle]').forEach((toggle) => {
      const panel = section.querySelector('#' + toggle.getAttribute('aria-controls'));
      if (!panel) return;

      toggle.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();

        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        panel.classList.toggle('is-open', open);

        if (open) {
          panel.hidden = false;
        } else {
          panel.addEventListener('transitionend', () => {
            if (toggle.getAttribute('aria-expanded') !== 'true') panel.hidden = true;
          }, { once: true });
        }
      });
    });


    /* ---------------------------------
       Discount code copy
    --------------------------------- */

    section.querySelectorAll('[data-copy-code]').forEach((button) => {
      button.addEventListener('click', async () => {
        const code = button.dataset.copyCode;
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);
          const label = button.querySelector('[data-copy-label]');
          if (label) {
            const original = label.textContent;
            label.textContent = 'copied';
            window.setTimeout(() => { label.textContent = original; }, 1800);
          }
        } catch (error) {
          console.warn('Could not copy discount code.', error);
        }
      });
    });


    /* ---------------------------------
       Mobile sticky CTA
    --------------------------------- */

    const sticky = section.querySelector('[data-laborday-sticky]');
    const hero = section.querySelector('.laborday__hero');

    if (sticky && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => sticky.classList.toggle('is-visible', !entry.isIntersecting),
        { threshold: 0.05 }
      ).observe(hero);
    }


    /* ---------------------------------
       CTA tracking event (GA4 / GTM / Elevar hook)
    --------------------------------- */

    section.querySelectorAll('[data-laborday-cta]').forEach((cta) => {
      cta.addEventListener('click', () => {
        window.dispatchEvent(
          new CustomEvent('threaditate:laborday-cta', {
            detail: {
              hook: section.dataset.activeHook || 'default',
              promo: '{{ promo_code | escape }}'
            }
          })
        );
      });
    });

  })();
</script>


