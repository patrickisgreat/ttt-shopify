{% comment %}
  Threaditate — LABOR DAY Landing Page
  /pages/labor-day
  September 2–7, 2026 · Buy one kit, get a second 50% off · Code: LABORDAY

  Built on the same bones as campus2-lander:
  - ID-scoped CSS (no !important, no fights with Bubbly)
  - Theme font variables, so it matches the rest of the store
  - Ad hook → hero message matching via ?hook= or ?utm_content=
  - Copy-to-clipboard code, mobile sticky CTA, CTA tracking events

  URL examples:
  /pages/labor-day?hook=one-to-give
  /pages/labor-day?hook=quiet-weekend
  /pages/labor-day?utm_content=actually-finish

  Create LABORDAY in Shopify Admin > Discounts (BOGO 50% off second kit).
{% endcomment %}

{% liquid
  assign promo_code = section.settings.discount_code | strip

  assign default_kit = all_products['string-ring-custom-string-art-kit']

  if section.settings.product != blank
    assign cta_path = section.settings.product.url
  elsif default_kit != blank
    assign cta_path = default_kit.url
  else
    assign cta_path = routes.all_products_collection_url
  endif

  comment
    Where the buttons go.
    - checkout: two kits in the cart, code applied, straight to checkout
    - cart:     two kits in the cart, code applied, cart page first
    - product:  the PDP, code applied
    Falls back to product if we can't find a variant.
  endcomment

  if section.settings.product != blank
    assign kit = section.settings.product
  else
    assign kit = default_kit
  endif

  assign variant_id = nil
  if kit != blank and kit.selected_or_first_available_variant != blank
    assign variant_id = kit.selected_or_first_available_variant.id
  endif

  assign cta_mode = section.settings.cta_mode | default: 'checkout'

  comment
    Cart permalinks build a fresh checkout and ignore the /discount/ cookie,
    so the code has to ride on the permalink itself as ?discount=CODE.
    The PDP route still uses /discount/CODE?redirect= (cookie), which the
    storefront cart honors on the way to checkout.
  endcomment

  assign cta_url = cta_path
  assign single_url = cta_path

  if promo_code != blank
    assign single_url = '/discount/' | append: promo_code | append: '?redirect=' | append: cta_path
  endif

  if variant_id != nil and cta_mode == 'checkout'
    assign cta_url = '/cart/' | append: variant_id | append: ':2'
    if promo_code != blank
      assign cta_url = cta_url | append: '?discount=' | append: promo_code
    endif
  elsif variant_id != nil and cta_mode == 'cart'
    assign cta_url = '/cart/' | append: variant_id | append: ':2?storefront=true'
    if promo_code != blank
      assign cta_url = cta_url | append: '&discount=' | append: promo_code
    endif
  else
    assign cta_url = single_url
  endif

  assign kit_price = section.settings.kit_price
  assign second_price = section.settings.second_kit_price
  assign bundle_price = section.settings.bundle_price
  assign savings = section.settings.savings
%}

<section
  id="LaborDay-{{ section.id }}"
  class="laborday"
  data-laborday-section
  data-sale-end="{{ section.settings.sale_end | escape }}"
>

  {% if section.settings.hide_theme_chrome %}
    <script>
      document.documentElement.classList.add('threaditate-lander-active');
    </script>
  {% endif %}


  {%- comment -%}
    ============================================================
    ANNOUNCEMENT
    ============================================================
  {%- endcomment -%}

  <div class="laborday__announcement">
    <div class="laborday__shell laborday__announcement-inner">
      <span class="laborday__announcement-text">{{ section.settings.announcement }}</span>

      {% if promo_code != blank %}
        <button
          class="laborday__code-button"
          type="button"
          data-copy-code="{{ promo_code | escape }}"
          aria-label="Copy discount code {{ promo_code }}"
        >
          {{ promo_code }}
          <span class="laborday__copy-label" data-copy-label>copy</span>
        </button>
      {% endif %}

      <span class="laborday__countdown" data-countdown hidden>
        ends in <strong data-countdown-value></strong>
      </span>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    HERO
    ============================================================
  {%- endcomment -%}

  <div class="laborday__hero">
    <div class="laborday__hero-grid laborday__shell">

      <div class="laborday__hero-copy">
        <p class="laborday__eyebrow" data-hook-eyebrow>
          {{ section.settings.hero_eyebrow }}
        </p>

        <h1 class="laborday__h1" data-hook-headline>
          {{ section.settings.hero_headline }}
        </h1>

        <p class="laborday__hero-subhead" data-hook-subhead>
          {{ section.settings.hero_subhead }}
        </p>

        <div class="laborday__hero-actions">
          <a
            class="laborday__button laborday__button--primary"
            href="{{ cta_url }}"
            data-laborday-cta
          >
            {{ section.settings.cta_label }}
            <span aria-hidden="true">→</span>
          </a>

          {% if promo_code != blank %}
            <p class="laborday__offer-note">
              {%- if cta_mode == 'product' -%}
                Add two kits, use code <strong>{{ promo_code }}</strong>.
                The second one rings up at half price.
              {%- else -%}
                Two kits go in your cart with <strong>{{ promo_code }}</strong> already applied.
                <a class="laborday__single-link" href="{{ single_url }}">Just want one?</a>
              {%- endif -%}
            </p>
          {% endif %}
        </div>

        <div class="laborday__micro-proof">
          <span>App included</span>
          <span aria-hidden="true">·</span>
          <span>No subscription</span>
          <span aria-hidden="true">·</span>
          <span>Any photo, any kit</span>
        </div>
      </div>


      <div class="laborday__hero-media">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              class: 'laborday__hero-image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600, 900, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.hero_image.alt
          }}
        {% else %}
          <div class="laborday__placeholder laborday__placeholder--hero">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
            <span>Select your Labor Day hero image</span>
          </div>
        {% endif %}

        <div class="laborday__hero-card">
          <span>Second kit</span>
          <strong>50% off</strong>
          <small>{{ promo_code }}</small>
        </div>
      </div>

    </div>
  </div>


  {%- comment -%}
    Hidden hook data. JS below message-matches the hero to ?hook= / ?utm_content=
  {%- endcomment -%}

  <div hidden data-hook-library>
    {% for block in section.blocks %}
      {% if block.type == 'hook' %}
        <span
          data-hook-record
          data-key="{{ block.settings.key | handleize }}"
          data-eyebrow="{{ block.settings.eyebrow | escape }}"
          data-headline="{{ block.settings.headline | escape }}"
          data-subhead="{{ block.settings.subhead | escape }}"
          {{ block.shopify_attributes }}
        ></span>
      {% endif %}
    {% endfor %}
  </div>


  {%- comment -%}
    ============================================================
    PROOF STRIP
    ============================================================
  {%- endcomment -%}

  <div class="laborday__proof">
    <div class="laborday__proof-grid laborday__shell">

      <div class="laborday__proof-item">
        <strong>2,013</strong>
        <span>Kickstarter backers</span>
      </div>

      <div class="laborday__proof-item">
        <strong>$158K</strong>
        <span>raised</span>
      </div>

      <div class="laborday__proof-item">
        <strong>Voice-guided</strong>
        <span>app included</span>
      </div>

      <div class="laborday__proof-item laborday__proof-item--quote">
        <strong>“I actually finished something.”</strong>
        <span>Priya N. · Kickstarter backer</span>
      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    ONE TO MAKE / ONE TO GIVE
    ============================================================
  {%- endcomment -%}

  <div class="laborday__section laborday__section--ivory">
    <div class="laborday__shell">

      <div class="laborday__section-heading">
        <p class="laborday__eyebrow">Two kits, two photos</p>
        <h2 class="laborday__h2">
          Keep one. Hand one over.
        </h2>
        <p>
          The long weekend is long enough for two. Pick a photo for each.
          They don't have to match. They don't have to be for the same person.
        </p>
      </div>

      <div class="laborday__pair">

        <article class="laborday__pair-card laborday__pair-card--make">
          <span class="laborday__pair-index">01</span>
          <h3>One to make.</h3>
          <p class="laborday__pair-lead">
            Three evenings, no screen, a photo you care about slowly turning into thread.
          </p>
          <ul>
            <li>The app reads each line out loud. Your eyes stay on the loom.</li>
            <li>Stop whenever. Your place is saved.</li>
            <li>Five to eight hours, spread however you like.</li>
          </ul>
          <a class="laborday__button laborday__button--ivory" href="{{ cta_url }}" data-laborday-cta>
            Make yours
            <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="laborday__pair-card laborday__pair-card--give">
          <span class="laborday__pair-index">02</span>
          <h3>One to give.</h3>
          <p class="laborday__pair-lead">
            Their dog. Their grandmother. The two of you, ten years ago. A gift they make with their own hands.
          </p>
          <ul>
            <li>Every kit works with any photo. Nothing to pre-order or customize.</li>
            <li>Birthdays are coming. So is December.</li>
            <li>Half price, this weekend only.</li>
          </ul>
          <a class="laborday__button laborday__button--black" href="{{ cta_url }}" data-laborday-cta>
            Give one
            <span aria-hidden="true">→</span>
          </a>
        </article>

      </div>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    HOW IT WORKS
    ============================================================
  {%- endcomment -%}

  <div class="laborday__section laborday__section--black">
    <div class="laborday__shell">

      <div class="laborday__section-heading">
        <p class="laborday__eyebrow laborday__eyebrow--marigold">How it works</p>
        <h2 class="laborday__h2 laborday__h2--light">
          From camera roll to wall.
        </h2>
      </div>

      <div class="laborday__steps">

        <article class="laborday__step">
          <div class="laborday__step-media">
            {% if section.settings.step1_image != blank %}
              {{
                section.settings.step1_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: section.settings.step1_image.alt
              }}
            {% else %}
              <div class="laborday__placeholder">
                {{ 'image' | placeholder_svg_tag }}
                <span>App upload screen</span>
              </div>
            {% endif %}
          </div>
          <span>01</span>
          <h3>Upload a photo</h3>
          <p>Any photo from your camera roll. The app turns it into a threading sequence.</p>
        </article>

        <article class="laborday__step">
          <div class="laborday__step-media">
            {% if section.settings.step2_image != blank %}
              {{
                section.settings.step2_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: section.settings.step2_image.alt
              }}
            {% else %}
              <div class="laborday__placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag }}
                <span>Hands threading</span>
              </div>
            {% endif %}
          </div>
          <span>02</span>
          <h3>Follow the voice</h3>
          <p>It tells you where to go next, line by line, at your pace. No counting.</p>
        </article>

        <article class="laborday__step">
          <div class="laborday__step-media">
            {% if section.settings.step3_image != blank %}
              {{
                section.settings.step3_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: section.settings.step3_image.alt
              }}
            {% else %}
              <div class="laborday__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag }}
                <span>Finished piece on a wall</span>
              </div>
            {% endif %}
          </div>
          <span>03</span>
          <h3>Hang your piece</h3>
          <p>Your photo, made in thread. On the wall by the end of the weekend, or whenever.</p>
        </article>

      </div>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    THE KIT + THE MATH
    ============================================================
  {%- endcomment -%}

  <div class="laborday__section laborday__section--sand">
    <div class="laborday__shell laborday__split">

      <div class="laborday__media-card">
        {% if section.settings.product_image != blank %}
          {{
            section.settings.product_image
            | image_url: width: 1500
            | image_tag:
              class: 'laborday__product-image',
              loading: 'lazy',
              widths: '500, 800, 1100, 1500',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: section.settings.product_image.alt
          }}
        {% else %}
          <div class="laborday__placeholder">
            {{ 'product-1' | placeholder_svg_tag }}
            <span>Kit contents flat lay</span>
          </div>
        {% endif %}
      </div>

      <div class="laborday__section-copy">
        <p class="laborday__eyebrow">What's in the box</p>
        <h2 class="laborday__h2">Everything. Twice.</h2>
        <p class="laborday__lead">
          Each kit is complete on its own. Two kits, two full sets, nothing shared.
        </p>

        <ul class="laborday__contents">
          <li>Loom and mounting hardware</li>
          <li>Thread, spool holder, threading tool</li>
          <li>Numbered guide and wooden phone stand</li>
          <li>Convertible easel box</li>
          <li>Lifetime app access, no subscription</li>
        </ul>

        <div class="laborday__math">
          <div class="laborday__math-row">
            <span>First kit</span>
            <strong>{{ kit_price }}</strong>
          </div>
          <div class="laborday__math-row laborday__math-row--deal">
            <span>Second kit <em>with {{ promo_code }}</em></span>
            <strong>{{ second_price }}</strong>
          </div>
          <div class="laborday__math-row laborday__math-row--total">
            <span>Two kits</span>
            <strong>{{ bundle_price }}</strong>
          </div>
          <p class="laborday__math-save">You save {{ savings }}.</p>
        </div>

        <a class="laborday__button laborday__button--primary" href="{{ cta_url }}" data-laborday-cta>
          {{ section.settings.cta_label }}
          <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    BACKER QUOTES
    ============================================================
  {%- endcomment -%}

  <div class="laborday__section laborday__section--white">
    <div class="laborday__shell">

      <p class="laborday__eyebrow">From the first 2,013</p>

      <div class="laborday__quotes">

        <figure class="laborday__quote laborday__quote--featured">
          <blockquote>
            “My mind went quiet about ten minutes in. I wasn't thinking about work
            or my phone or anything. Just the next line.”
          </blockquote>
          <figcaption>Derek P. · Kickstarter backer</figcaption>
        </figure>

        <figure class="laborday__quote">
          <blockquote>
            “I actually finished something. That never happens with craft kits.”
          </blockquote>
          <figcaption>Priya N. · Kickstarter backer</figcaption>
        </figure>

        <figure class="laborday__quote">
          <blockquote>
            “People ask where I bought it. I made it. On my couch.”
          </blockquote>
          <figcaption>Marisa T. · Kickstarter backer</figcaption>
        </figure>

      </div>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    OFFER
    ============================================================
  {%- endcomment -%}

  <div class="laborday__offer">
    <div class="laborday__shell laborday__offer-inner">

      <p class="laborday__eyebrow laborday__eyebrow--light">
        Labor Day weekend · September 2–7
      </p>

      <h2 class="laborday__h2 laborday__h2--light">
        Buy one kit. The second is half off.
      </h2>

      <p class="laborday__offer-copy">
        Two photos. Two looms. One quiet weekend.
        After Sunday it's back to full price.
      </p>

      {% if promo_code != blank %}
        <button
          type="button"
          class="laborday__big-code"
          data-copy-code="{{ promo_code | escape }}"
        >
          <span>At checkout, use</span>
          <strong>{{ promo_code }}</strong>
          <small data-copy-label>tap to copy</small>
        </button>
      {% endif %}

      <a class="laborday__button laborday__button--black" href="{{ cta_url }}" data-laborday-cta>
        {{ section.settings.cta_label }}
        <span aria-hidden="true">→</span>
      </a>

      <p class="laborday__offer-fine">
        <span data-countdown-inline hidden>Ends in <strong data-countdown-value></strong>. </span>
        Applies to the second kit in your cart. App included. Ships within one business day. 30-day returns.
        {%- if cta_mode != 'product' %}
          <a class="laborday__single-link laborday__single-link--light" href="{{ single_url }}">Only need one kit?</a>
        {%- endif %}
      </p>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    FAQ
    ============================================================
  {%- endcomment -%}

  <div class="laborday__section laborday__section--ivory">
    <div class="laborday__shell laborday__faq-shell">

      <div class="laborday__section-heading">
        <p class="laborday__eyebrow">Good questions</p>
        <h2 class="laborday__h2">Clear answers.</h2>
      </div>

      <div class="laborday__faq">

        <div class="laborday__faq-item" data-faq-item>
          <h3 class="laborday__faq-q">
            <button type="button" class="laborday__faq-toggle" aria-expanded="false" aria-controls="LaborDayFaq-{{ section.id }}-1" data-faq-toggle>
              <span>How does the buy one, get one work?</span>
              <span class="laborday__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="laborday__faq-panel" id="LaborDayFaq-{{ section.id }}-1" data-faq-panel hidden>
            <div class="laborday__faq-panel-inner">
              <p>
              Add two kits to your cart and enter {{ promo_code }} at checkout.
              The second kit drops to half price. Want four? The discount applies to every second kit.
            </p>
            </div>
          </div>
        </div>

        <div class="laborday__faq-item" data-faq-item>
          <h3 class="laborday__faq-q">
            <button type="button" class="laborday__faq-toggle" aria-expanded="false" aria-controls="LaborDayFaq-{{ section.id }}-2" data-faq-toggle>
              <span>Can each kit use a different photo?</span>
              <span class="laborday__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="laborday__faq-panel" id="LaborDayFaq-{{ section.id }}-2" data-faq-panel hidden>
            <div class="laborday__faq-panel-inner">
              <p>
              Yes. The photo lives in the app, not the kit. Whoever ends up with the kit
              picks their own photo when they start.
            </p>
            </div>
          </div>
        </div>

        <div class="laborday__faq-item" data-faq-item>
          <h3 class="laborday__faq-q">
            <button type="button" class="laborday__faq-toggle" aria-expanded="false" aria-controls="LaborDayFaq-{{ section.id }}-3" data-faq-toggle>
              <span>Do I need to know how to make string art?</span>
              <span class="laborday__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="laborday__faq-panel" id="LaborDayFaq-{{ section.id }}-3" data-faq-panel hidden>
            <div class="laborday__faq-panel-inner">
              <p>
              No. The app speaks each step out loud and moves line by line at your pace.
              Most first-timers finish their first piece.
            </p>
            </div>
          </div>
        </div>

        <div class="laborday__faq-item" data-faq-item>
          <h3 class="laborday__faq-q">
            <button type="button" class="laborday__faq-toggle" aria-expanded="false" aria-controls="LaborDayFaq-{{ section.id }}-4" data-faq-toggle>
              <span>How long does one take?</span>
              <span class="laborday__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="laborday__faq-panel" id="LaborDayFaq-{{ section.id }}-4" data-faq-panel hidden>
            <div class="laborday__faq-panel-inner">
              <p>
              About 5–8 hours depending on the image. Spread it across as many sessions as
              you want. The app saves your progress.
            </p>
            </div>
          </div>
        </div>

        <div class="laborday__faq-item" data-faq-item>
          <h3 class="laborday__faq-q">
            <button type="button" class="laborday__faq-toggle" aria-expanded="false" aria-controls="LaborDayFaq-{{ section.id }}-5" data-faq-toggle>
              <span>What if I mess up?</span>
              <span class="laborday__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="laborday__faq-panel" id="LaborDayFaq-{{ section.id }}-5" data-faq-panel hidden>
            <div class="laborday__faq-panel-inner">
              <p>
              Keep going. Thousands of lines make the image, so a missed step disappears
              into the whole. Nothing to rip out.
            </p>
            </div>
          </div>
        </div>

        <div class="laborday__faq-item" data-faq-item>
          <h3 class="laborday__faq-q">
            <button type="button" class="laborday__faq-toggle" aria-expanded="false" aria-controls="LaborDayFaq-{{ section.id }}-6" data-faq-toggle>
              <span>Is the app extra?</span>
              <span class="laborday__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="laborday__faq-panel" id="LaborDayFaq-{{ section.id }}-6" data-faq-panel hidden>
            <div class="laborday__faq-panel-inner">
              <p>No. App access comes with the kit. No subscription, ever.</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    FINAL CTA
    ============================================================
  {%- endcomment -%}

  <div class="laborday__final">
    <div class="laborday__shell laborday__final-inner">
      <p>Three days off.</p>
      <h2>Make something with them.</h2>
      {% if promo_code != blank %}
        <span>Second kit 50% off with code {{ promo_code }} · through September 7</span>
      {% endif %}
      <a class="laborday__button laborday__button--primary" href="{{ cta_url }}" data-laborday-cta>
        {{ section.settings.cta_label }}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    MOBILE STICKY CTA
    ============================================================
  {%- endcomment -%}

  <div class="laborday__sticky" data-laborday-sticky>
    <div>
      <strong>2nd kit 50% off</strong>
      <span>{{ promo_code }}</span>
    </div>
    <a href="{{ cta_url }}" data-laborday-cta>
