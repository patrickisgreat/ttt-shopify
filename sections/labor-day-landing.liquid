<script>
  // Show sticky bar after scrolling past the hero
  (function () {
    var bar = document.getElementById('ld-sticky-bar');
    if (!bar) return;

    var hero = document.querySelector('.ld-hero');
    if (!hero) { bar.classList.add('is-visible'); return; }

    var threshold = hero.offsetTop + hero.offsetHeight;
    var visible = false;

    function check() {
      var shouldShow = window.scrollY > threshold;
      if (shouldShow !== visible) {
        visible = shouldShow;
        bar.classList.toggle('is-visible', visible);
      }
    }

    window.addEventListener('scroll', check, { passive: true });
    check();
  })();
</script>

