{% comment %}
  Threaditate — Labor Day Weekend Sale Landing Page (v2)
  /pages/labor-day
  September 2–7, 2026 | BOGO 50% off | Code: LABORDAY

  Drop this file into your theme's sections/ folder.
  Pair with templates/page.labor-day.json.
  All images are editable via the theme editor (Customize).
{% endcomment %}

{{ 'section-labor-day.css' | asset_url | stylesheet_tag }}

<style>
  /* ========================================================
     LABOR DAY LANDING PAGE v2 — Visual Redesign
     Threaditate / Heartistry LLC
     Dark hero, vermillion CTAs, full brand palette
     ======================================================== */

  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap');

  :root {
    --thd-cobalt: #1450C4;
    --thd-violet: #3D3DB0;
    --thd-vermillion: #C43D2E;
    --thd-black: #0B0B0F;
    --thd-ivory: #F4F2ED;
    --thd-cobalt-light: #E8EEF9;
    --thd-warm-gray: #D4D0CA;
    --thd-violet-light: #EEEDF8;
    --thd-vermillion-light: #FCEEED;
    --thd-font-heading: 'Space Grotesk', system-ui, sans-serif;
    --thd-font-body: 'DM Sans', system-ui, sans-serif;
  }

  .ld-page {
    font-family: var(--thd-font-body);
    color: var(--thd-black);
    line-height: 1.6;
    overflow-x: hidden;
  }

  .ld-page *,
  .ld-page *::before,
  .ld-page *::after {
    box-sizing: border-box;
  }

  .ld-page h1,
  .ld-page h2,
  .ld-page h3,
  .ld-page h4 {
    font-family: var(--thd-font-heading);
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
  }

  .ld-page p {
    margin: 0;
  }

  .ld-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---- CTA Buttons ---- */

  .ld-btn {
    display: inline-block;
    font-family: var(--thd-font-heading);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0.01em;
    color: #fff;
    background: var(--thd-vermillion);
    border: none;
    border-radius: 6px;
    padding: 16px 36px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(196, 61, 46, 0.25);
  }

  .ld-btn:hover {
    background: #A83325;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(196, 61, 46, 0.3);
  }

  .ld-btn--secondary {
    background: var(--thd-cobalt);
    box-shadow: 0 2px 8px rgba(20, 80, 196, 0.2);
  }

  .ld-btn--secondary:hover {
    background: var(--thd-violet);
    box-shadow: 0 4px 14px rgba(61, 61, 176, 0.25);
  }

  .ld-btn--violet {
    background: var(--thd-violet);
    box-shadow: 0 2px 8px rgba(61, 61, 176, 0.2);
  }

  .ld-btn--violet:hover {
    background: #2E2E8F;
  }

  /* ---- Image placeholders ---- */

  .ld-placeholder {
    background: linear-gradient(135deg, var(--thd-cobalt-light) 0%, var(--thd-violet-light) 100%);
    border: 2px dashed var(--thd-warm-gray);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6B7280;
    font-size: 13px;
    font-family: var(--thd-font-body);
    text-align: center;
    padding: 20px;
  }


  /* ============================================================
     SECTION 1: HERO — Dark gradient (black → violet)
     ============================================================ */

  .ld-hero {
    background: linear-gradient(165deg, var(--thd-black) 0%, #161640 55%, var(--thd-violet) 100%);
    padding: 96px 0 88px;
    position: relative;
    overflow: hidden;
  }

  /* subtle thread-line texture */
  .ld-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 59px,
        rgba(255,255,255,0.03) 59px,
        rgba(255,255,255,0.03) 60px
      );
    pointer-events: none;
  }

  .ld-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .ld-hero__badge {
    display: inline-block;
    font-family: var(--thd-font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--thd-vermillion);
    border-radius: 100px;
    padding: 7px 18px;
    margin-bottom: 24px;
  }

  .ld-hero__headline {
    font-size: clamp(38px, 5.5vw, 60px);
    color: #fff;
    margin-bottom: 20px;
    letter-spacing: -0.01em;
  }

  .ld-hero__headline em {
    font-style: normal;
    color: var(--thd-ivory);
    opacity: 0.7;
  }

  .ld-hero__subhead {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.75);
    max-width: 460px;
    margin-bottom: 16px;
    line-height: 1.65;
  }

  .ld-hero__offer {
    font-family: var(--thd-font-heading);
    font-weight: 600;
    font-size: 16px;
    color: #FBBF24;
    margin-bottom: 36px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ld-hero__offer-line {
    width: 32px;
    height: 2px;
    background: rgba(251, 191, 36, 0.4);
    border-radius: 1px;
  }

  .ld-hero__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .ld-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* ============================================================
     SECTION 2: SOCIAL PROOF BAR — Ivory background
     ============================================================ */

  .ld-proof-bar {
    background: var(--thd-ivory);
    color: var(--thd-black);
    padding: 24px 0;
    border-bottom: 1px solid var(--thd-warm-gray);
  }

  .ld-proof-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 36px;
    flex-wrap: wrap;
  }

  .ld-proof-bar__stat {
    font-family: var(--thd-font-heading);
    font-weight: 600;
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .ld-proof-bar__stat svg {
    flex-shrink: 0;
  }

  .ld-proof-bar__divider {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--thd-warm-gray);
  }

  .ld-proof-bar__quote {
    font-family: var(--thd-font-body);
    font-style: italic;
    font-size: 15px;
    color: #6B7280;
  }


  /* ============================================================
     SECTION 3: SPLIT CARDS — Differentiated backgrounds
     ============================================================ */

  .ld-split {
    padding: 88px 0;
    background: #fff;
  }

  .ld-split__heading {
    text-align: center;
    font-size: clamp(28px, 4vw, 42px);
    color: var(--thd-black);
    margin-bottom: 12px;
  }

  .ld-split__subtext {
    text-align: center;
    font-size: 17px;
    color: #6B7280;
    max-width: 520px;
    margin: 0 auto 52px;
  }

  .ld-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .ld-split__card {
    border-radius: 20px;
    padding: 44px 36px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .ld-split__card--make {
    background: linear-gradient(170deg, var(--thd-violet-light) 0%, #F8F7FF 100%);
    border: 1px solid rgba(61, 61, 176, 0.1);
  }

  .ld-split__card--give {
    background: linear-gradient(170deg, var(--thd-vermillion-light) 0%, #FFF9F8 100%);
    border: 1px solid rgba(196, 61, 46, 0.08);
  }

  .ld-split__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ld-split__card--make .ld-split__icon {
    background: rgba(61, 61, 176, 0.1);
    color: var(--thd-violet);
  }

  .ld-split__card--give .ld-split__icon {
    background: rgba(196, 61, 46, 0.1);
    color: var(--thd-vermillion);
  }

  .ld-split__card-title {
    font-size: 24px;
    color: var(--thd-black);
    margin-bottom: 12px;
  }

  .ld-split__card-text {
    font-size: 16px;
    color: #4B5563;
    margin-bottom: 32px;
    line-height: 1.65;
    max-width: 340px;
    margin-left: auto;
    margin-right: auto;
  }

  .ld-split__card--make .ld-btn {
    background: var(--thd-violet);
    box-shadow: 0 2px 8px rgba(61, 61, 176, 0.2);
  }

  .ld-split__card--make .ld-btn:hover {
    background: #2E2E8F;
  }


  /* ============================================================
     SECTION 4: HOW IT WORKS — Dark background
     ============================================================ */

  .ld-how {
    padding: 88px 0;
    background: var(--thd-black);
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .ld-how::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(61, 61, 176, 0.15) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 50%, rgba(20, 80, 196, 0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .ld-how__heading {
    text-align: center;
    font-size: clamp(28px, 4vw, 42px);
    margin-bottom: 60px;
    position: relative;
  }

  .ld-how__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 960px;
    margin: 0 auto;
    position: relative;
  }

  .ld-how__step {
    text-align: center;
    position: relative;
  }

  .ld-how__step-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--thd-vermillion);
    color: #fff;
    font-family: var(--thd-font-heading);
    font-weight: 700;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    box-shadow: 0 4px 16px rgba(196, 61, 46, 0.35);
  }

  .ld-how__step-image {
    width: 100%;
    aspect-ratio: 1;
    max-width: 200px;
    margin: 0 auto 24px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .ld-how__step-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ld-how__step-title {
    font-size: 20px;
    margin-bottom: 8px;
  }

  .ld-how__step-text {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.6);
    max-width: 260px;
    margin: 0 auto;
  }

  /* connector dots between steps */
  .ld-how__step:not(:last-child)::after {
    content: '\b7 \b7 \b7';
    position: absolute;
    top: 22px;
    right: -18px;
    font-size: 16px;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.2);
  }


  /* ============================================================
     SECTION 5: PRODUCT / WHAT'S IN THE BOX
     ============================================================ */

  .ld-product {
    padding: 88px 0;
    background: #fff;
  }

  .ld-product__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .ld-product__image-wrap {
    position: relative;
  }

  .ld-product__image-wrap::before {
    content: '';
    position: absolute;
    inset: 12px -12px -12px 12px;
    background: var(--thd-cobalt-light);
    border-radius: 16px;
    z-index: 0;
  }

  .ld-product__image {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #E5E7EB;
  }

  .ld-product__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ld-product__heading {
    font-size: clamp(26px, 3.5vw, 38px);
    color: var(--thd-black);
    margin-bottom: 20px;
  }

  .ld-product__text {
    font-size: 16px;
    color: #4B5563;
    margin-bottom: 28px;
    line-height: 1.7;
  }

  .ld-product__list {
    list-style: none;
    padding: 0;
    margin: 0 0 36px 0;
  }

  .ld-product__list li {
    font-size: 16px;
    color: var(--thd-black);
    padding: 11px 0;
    border-bottom: 1px solid #F3F4F6;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .ld-product__list li:last-child {
    border-bottom: none;
  }

  .ld-check-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--thd-cobalt-light);
    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* ============================================================
     SECTION 6: BACKER TESTIMONIALS — Colored borders + stars
     ============================================================ */

  .ld-testimonials {
    padding: 88px 0;
    background: linear-gradient(175deg, var(--thd-ivory) 0%, #EBE8E2 100%);
  }

  .ld-testimonials__heading {
    text-align: center;
    font-size: clamp(28px, 4vw, 42px);
    color: var(--thd-black);
    margin-bottom: 48px;
  }

  .ld-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .ld-tcard {
    background: #fff;
    border-radius: 16px;
    padding: 32px 28px;
    border-left: 4px solid transparent;
    transition: transform 0.2s ease;
  }

  .ld-tcard:hover {
    transform: translateY(-3px);
  }

  .ld-tcard:nth-child(1) { border-left-color: var(--thd-cobalt); }
  .ld-tcard:nth-child(2) { border-left-color: var(--thd-violet); }
  .ld-tcard:nth-child(3) { border-left-color: var(--thd-vermillion); }

  .ld-tcard__stars {
    display: flex;
    gap: 2px;
    margin-bottom: 16px;
  }

  .ld-tcard__text {
    font-size: 16px;
    color: #374151;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .ld-tcard__author {
    font-family: var(--thd-font-heading);
    font-weight: 600;
    font-size: 14px;
    color: var(--thd-black);
  }

  .ld-tcard__role {
    font-size: 13px;
    color: #9CA3AF;
    margin-top: 2px;
  }

  .ld-testimonials__cta {
    text-align: center;
    margin-top: 52px;
  }


  /* ============================================================
     SECTION 7: STICKY CTA BAR — Dark
     ============================================================ */

  .ld-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--thd-black);
    padding: 14px 0;
    z-index: 999;
    transform: translateY(100%);
    transition: transform 0.35s ease;
    box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.2);
  }

  .ld-sticky-bar.is-visible {
    transform: translateY(0);
  }

  .ld-sticky-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .ld-sticky-bar__text {
    font-family: var(--thd-font-heading);
    font-weight: 600;
    font-size: 15px;
    color: #fff;
  }

  .ld-sticky-bar__offer {
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    font-weight: 400;
  }

  .ld-sticky-bar .ld-btn {
    padding: 12px 28px;
    font-size: 14px;
  }


  /* ============================================================
     RESPONSIVE
     ============================================================ */

  @media (max-width: 768px) {
    .ld-hero {
      padding: 56px 0 48px;
    }

    .ld-hero__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ld-hero__image {
      order: -1;
      aspect-ratio: 16 / 9;
    }

    .ld-split__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ld-split__card {
      padding: 32px 24px;
    }

    .ld-how__steps {
      grid-template-columns: 1fr;
      gap: 36px;
      max-width: 320px;
    }

    .ld-how__step:not(:last-child)::after {
      display: none;
    }

    .ld-product__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ld-product__image-wrap {
      order: -1;
    }

    .ld-product__image {
      aspect-ratio: 4 / 3;
    }

    .ld-testimonials__grid {
      grid-template-columns: 1fr;
    }

    .ld-sticky-bar__inner {
      flex-direction: column;
      text-align: center;
      gap: 10px;
    }

    .ld-proof-bar__inner {
      flex-direction: column;
      gap: 10px;
    }

    .ld-proof-bar__divider {
      display: none;
    }

    .ld-split, .ld-how, .ld-product, .ld-testimonials {
      padding: 60px 0;
    }
  }
</style>

{%- assign cta_link = section.settings.cta_url | default: routes.all_products_collection_url -%}

<div class="ld-page">

  <!-- ====================================
       SECTION 1: HERO — Dark gradient
       ==================================== -->
  <section class="ld-hero">
    <div class="ld-container">
      <div class="ld-hero__inner">
        <div class="ld-hero__content">
          <span class="ld-hero__badge">Labor Day sale &middot; Sep 2 &ndash; 7</span>
          <h1 class="ld-hero__headline">One to make.<br><em>One to give.</em></h1>
          <p class="ld-hero__subhead">
            Buy one Threaditate kit, get a second at half price.
            Choose any photo for each.
          </p>
          <p class="ld-hero__offer">
            <span class="ld-hero__offer-line"></span>
            Two kits for $133.50 &middot; save $44.50
          </p>
          <a href="{{ cta_link }}" class="ld-btn">Make yours</a>
        </div>
        <div class="ld-hero__image">
          {% if section.settings.hero_image != blank %}
            {{ section.settings.hero_image | image_url: width: 1200 | image_tag:
              loading: 'eager',
              alt: 'Two Threaditate kits — one to make, one to give'
            }}
          {% else %}
            <div class="ld-placeholder" style="width:100%;height:100%;background:linear-gradient(135deg, rgba(20,80,196,0.15), rgba(61,61,176,0.2));border-color:rgba(255,255,255,0.15);">
              Hero image<br>1200 &times; 900px<br>Two people threading or finished piece next to photo
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>


  <!-- ====================================
       SECTION 2: SOCIAL PROOF BAR — Ivory
       ==================================== -->
  <section class="ld-proof-bar">
    <div class="ld-container">
      <div class="ld-proof-bar__inner">
        <div class="ld-proof-bar__stat">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M10 1l2.47 5.01L18 6.94l-4 3.9.94 5.5L10 13.77l-4.94 2.57.94-5.5-4-3.9 5.53-.93L10 1z" fill="#FBBF24"/></svg>
          2,013 Kickstarter backers
        </div>
        <div class="ld-proof-bar__divider"></div>
        <div class="ld-proof-bar__stat">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M10 1l2.47 5.01L18 6.94l-4 3.9.94 5.5L10 13.77l-4.94 2.57.94-5.5-4-3.9 5.53-.93L10 1z" fill="#FBBF24"/></svg>
          $158K raised
        </div>
        <div class="ld-proof-bar__divider"></div>
        <div class="ld-proof-bar__quote">
          &ldquo;I actually finished something. That never happens.&rdquo; &mdash; Priya N.
        </div>
      </div>
    </div>
  </section>


  <!-- ====================================
       SECTION 3: ONE TO MAKE. ONE TO GIVE.
       ==================================== -->
  <section class="ld-split">
    <div class="ld-container">
      <h2 class="ld-split__heading">Two kits. Two photos. One quiet weekend.</h2>
      <p class="ld-split__subtext">
        The BOGO is built for sharing. Keep one, give one &mdash; or make them side by side.
      </p>
      <div class="ld-split__grid">

        <!-- Make yours — violet tint -->
        <div class="ld-split__card ld-split__card--make">
          <div class="ld-split__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3 class="ld-split__card-title">Make yours</h3>
          <p class="ld-split__card-text">
            A screen-free evening that ends with something on your wall.
            Pick a photo that matters, follow the voice guide, and let your mind go quiet.
          </p>
          <a href="{{ cta_link }}" class="ld-btn">Start making</a>
        </div>

        <!-- Give one — vermillion tint -->
        <div class="ld-split__card ld-split__card--give">
          <div class="ld-split__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 12v7a2 2 0 01-2 2H6a2 2 0 01-2-2v-7"/>
              <path d="M12 17V3"/>
              <path d="M4 12h16"/>
              <path d="M12 3l-4 4"/>
              <path d="M12 3l4 4"/>
            </svg>
          </div>
          <h3 class="ld-split__card-title">Give one</h3>
          <p class="ld-split__card-text">
            A personalized gift they won't expect. Choose their favorite photo &mdash;
            a pet, a place, a person &mdash; and they'll make something they keep forever.
          </p>
