            }}
          {% else %}
            <div class="spooky__placeholder">
              {{ 'image' | placeholder_svg_tag }}
              <span>Before · the photo · 1200 x 1500</span>
            </div>
          {% endif %}
          <figcaption>The photo</figcaption>
        </figure>

        <figure class="spooky__reveal-card">
          {% if section.settings.after_image != blank %}
            {{
              section.settings.after_image
              | image_url: width: 1200
              | image_tag:
