          </div>
          <div class="spooky__math-row spooky__math-row--deal">
            <span>Second kit <em>with {{ promo_code }}</em></span>
            <strong>{{ second_price }}</strong>
          </div>
          <div class="spooky__math-row spooky__math-row--total">
            <span>Two kits</span>
            <strong>{{ bundle_price }}</strong>
          </div>
          <p class="spooky__math-save">You save {{ savings }}.</p>
        </div>

        <a class="spooky__button spooky__button--primary" href="{{ cta_url }}" data-spooky-cta>
