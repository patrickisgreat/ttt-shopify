    <div class="spooky__shell">

      <div class="spooky__section-heading">
        <p class="spooky__eyebrow spooky__eyebrow--pumpkin">The reveal</p>
        <h2 class="spooky__h2 spooky__h2--light">It starts as a photo.</h2>
      </div>

