                widths: '400, 800, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: section.settings.after_image.alt
            }}
          {% else %}
            <div class="spooky__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag }}
              <span>After · the piece · 1200 x 1500</span>
            </div>
          {% endif %}
          <figcaption>The piece</figcaption>
        </figure>

      </div>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    OFFER
    ============================================================
  {%- endcomment -%}

  <div class="spooky__offer">
    <div class="spooky__shell spooky__offer-inner">

      <p class="spooky__eyebrow">
        October 1 to 31
      </p>

      <h2 class="spooky__h2">
        Buy one kit. Second kit 50% off.
      </h2>

