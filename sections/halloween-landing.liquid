{% comment %}
  Threaditate — HALLOWEEN Landing Page
  /pages/halloween
  Thu Oct 1 to Sat Oct 31, 2026 · Buy one kit, get a second 50% off · Code: SPOOKY

  Cloned from fall-sale-landing (which is cloned from labor-day-landing, the
  reference build), reskinned per Threaditate_Promo_Briefs_v2 chapter 6:
  - Henny Penny (cute spooky) for H1/H2 and the pair cards, Instrument Serif
    Italic for the featured quote, theme fonts everywhere else
    (swap-ins if Henny Penny wears thin: Griffy, Mystery Quest)
  - Black and orange: smoke / pumpkin / candle / bone
  - Dark hero, quotes directly under it, pet portrait feature, BOGO pair block
  - Two-kit math, before/after reveal, same hook library, countdown,
    copy-code, sticky CTA, FAQ accordion

  URL examples:
  /pages/halloween?hook=haunting
  /pages/halloween?hook=pet-portrait
  /pages/halloween?utm_content=october-making

  Create SPOOKY in Shopify Admin > Discounts as Buy X Get Y:
  buy 1 String Ring kit, get 1 at 50% off, Oct 1 to 31. Never also set a
  sale price on the product (they stack).
{% endcomment %}

{% liquid
  assign promo_code = section.settings.discount_code | strip

  assign default_kit = all_products['string-ring-custom-string-art-kit']

  if section.settings.product != blank
    assign cta_path = section.settings.product.url
  elsif default_kit != blank
    assign cta_path = default_kit.url
  else
    assign cta_path = routes.all_products_collection_url
  endif

  comment
    Where the buttons go.
    - checkout: two kits in the cart, code applied, straight to checkout
    - cart:     two kits in the cart, code applied, cart page first
    - product:  the PDP, code applied
    Falls back to product if we can't find a variant.
  endcomment

  if section.settings.product != blank
    assign kit = section.settings.product
  else
    assign kit = default_kit
  endif

  assign variant_id = nil
  if kit != blank and kit.selected_or_first_available_variant != blank
    assign variant_id = kit.selected_or_first_available_variant.id
  endif

  assign cta_mode = section.settings.cta_mode | default: 'checkout'

  comment
    Cart permalinks build a fresh checkout and ignore the /discount/ cookie,
    so the code has to ride on the permalink itself as ?discount=CODE.
    The PDP route still uses /discount/CODE?redirect= (cookie), which the
    storefront cart honors on the way to checkout.
  endcomment

  assign cta_url = cta_path
  assign single_url = cta_path

  if promo_code != blank
    assign single_url = '/discount/' | append: promo_code | append: '?redirect=' | append: cta_path
  endif

  if variant_id != nil and cta_mode == 'checkout'
    assign cta_url = '/cart/' | append: variant_id | append: ':2'
    if promo_code != blank
      assign cta_url = cta_url | append: '?discount=' | append: promo_code
    endif
  elsif variant_id != nil and cta_mode == 'cart'
    assign cta_url = '/cart/' | append: variant_id | append: ':2?storefront=true'
    if promo_code != blank
      assign cta_url = cta_url | append: '&discount=' | append: promo_code
    endif
  else
    assign cta_url = single_url
  endif

  assign kit_price = section.settings.kit_price
  assign second_price = section.settings.second_kit_price
  assign bundle_price = section.settings.bundle_price
  assign savings = section.settings.savings
%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Henny+Penny&family=Instrument+Serif:ital@1&display=swap" rel="stylesheet">

<section
  id="Spooky-{{ section.id }}"
  class="spooky"
  data-spooky-section
  data-sale-end="{{ section.settings.sale_end | escape }}"
>

  {% if section.settings.hide_theme_chrome %}
    <script>
      document.documentElement.classList.add('threaditate-lander-active');
    </script>
  {% endif %}


  {%- comment -%}
    ============================================================
    ANNOUNCEMENT
    ============================================================
  {%- endcomment -%}

  <div class="spooky__announcement">
    <div class="spooky__shell spooky__announcement-inner">
      <span class="spooky__announcement-text">{{ section.settings.announcement }}</span>

      {% if promo_code != blank %}
        <button
          class="spooky__code-button"
          type="button"
          data-copy-code="{{ promo_code | escape }}"
          aria-label="Copy discount code {{ promo_code }}"
        >
          {{ promo_code }}
          <span class="spooky__copy-label" data-copy-label>copy</span>
        </button>
      {% endif %}

      <span class="spooky__countdown" data-countdown hidden>
        ends in <strong data-countdown-value></strong>
      </span>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    HERO
    ============================================================
  {%- endcomment -%}

  <div class="spooky__hero">
    {% if section.settings.hero_texture != blank %}
      <div class="spooky__hero-texture" aria-hidden="true">
        {{
          section.settings.hero_texture
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            widths: '800, 1200, 1800, 2400',
            sizes: '100vw',
            alt: ''
        }}
      </div>
    {% endif %}
    <div class="spooky__hero-grid spooky__shell">

      <div class="spooky__hero-copy">
        <p class="spooky__eyebrow" data-hook-eyebrow>
          {{ section.settings.hero_eyebrow }}
        </p>

        <h1 class="spooky__h1" data-hook-headline>
          {{ section.settings.hero_headline }}
        </h1>

        <p class="spooky__hero-subhead" data-hook-subhead>
          {{ section.settings.hero_subhead }}
        </p>

        <div class="spooky__hero-actions">
          <a
            class="spooky__button spooky__button--primary"
            href="{{ cta_url }}"
            data-spooky-cta
          >
            {{ section.settings.cta_label }}
            <span aria-hidden="true">→</span>
          </a>

          {% if promo_code != blank %}
            <p class="spooky__offer-note">
              {%- if cta_mode == 'product' -%}
                Code <strong>{{ promo_code }}</strong> is applied when you land on the kit. Any kit, any photo.
              {%- else -%}
                Two kits go in your cart with <strong>{{ promo_code }}</strong> already applied.
                <a class="spooky__single-link" href="{{ single_url }}">Just want one?</a>
              {%- endif -%}
            </p>
          {% endif %}
        </div>

        <div class="spooky__micro-proof">
          <span>App included</span>
          <span aria-hidden="true">·</span>
          <span>No subscription</span>
          <span aria-hidden="true">·</span>
          <span>Any photo. Pets welcome.</span>
        </div>
      </div>


      <div class="spooky__hero-media">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              class: 'spooky__hero-image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600, 900, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.hero_image.alt
          }}
        {% else %}
          <div class="spooky__placeholder spooky__placeholder--hero">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
            <span>Select your Halloween hero image</span>
          </div>
        {% endif %}

        <div class="spooky__hero-card">
          <span>Second kit</span>
          <strong>{{ second_price }}</strong>
          <small>{{ promo_code }}</small>
        </div>
      </div>

    </div>
  </div>


  {%- comment -%}
    Hidden hook data. JS below message-matches the hero to ?hook= / ?utm_content=
  {%- endcomment -%}

  <div hidden data-hook-library>
    {% for block in section.blocks %}
      {% if block.type == 'hook' %}
        <span
          data-hook-record
          data-key="{{ block.settings.key | handleize }}"
          data-eyebrow="{{ block.settings.eyebrow | escape }}"
          data-headline="{{ block.settings.headline | escape }}"
          data-subhead="{{ block.settings.subhead | escape }}"
          {{ block.shopify_attributes }}
        ></span>
      {% endif %}
    {% endfor %}
  </div>


  {%- comment -%}
    ============================================================
    BACKER QUOTES
    ============================================================
  {%- endcomment -%}

  <div class="spooky__section spooky__section--white">
    <div class="spooky__shell">

      <p class="spooky__eyebrow">From people who finished one</p>

