    border-top: 1px solid var(--tt-black);
    font-size: 19px;
  }

  #FallFlash-{{ section.id }} .fallflash__math-row--total strong {
    font-size: 28px;
  }

  #FallFlash-{{ section.id }} .fallflash__math-save {
    margin-top: 6px;
    font-size: 13px;
    color: rgba(11,11,15,.6);
  }


  /* ---------- quotes ---------- */

  #FallFlash-{{ section.id }} .fallflash__quotes {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 18px;
  }

  #FallFlash-{{ section.id }} .fallflash__quote {
    margin: 0;
    padding: clamp(28px, 4vw, 48px);
    background: var(--tt-ivory);
    border: 1px solid rgba(11,11,15,.12);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  #FallFlash-{{ section.id }} .fallflash__quote--featured {
    background: var(--tt-clay);
    color: #fff;
    border-color: var(--tt-clay);
  }

  #FallFlash-{{ section.id }} .fallflash__quote blockquote {
    margin: 0;
    font-family: var(--tt-heading);
    font-size: clamp(21px, 2.2vw, 30px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.025em;
  }

  #FallFlash-{{ section.id }} .fallflash__quote--featured blockquote {
    font-size: clamp(26px, 3vw, 40px);
  }

  #FallFlash-{{ section.id }} .fallflash__quote figcaption {
    margin-top: 28px;
    font-size: 13px;
    opacity: .68;
  }


  /* ---------- offer ---------- */

  #FallFlash-{{ section.id }} .fallflash__offer {
    position: relative;
    padding-block: clamp(80px, 11vw, 150px);
    background:
      linear-gradient(135deg, var(--tt-clay) 0%, var(--tt-ochre) 100%);
    color: #fff;
    text-align: center;
    overflow: hidden;
  }

  #FallFlash-{{ section.id }} .fallflash__offer::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        -32deg,
        rgba(255,255,255,.07) 0 1px,
        transparent 1px 18px
      );
    pointer-events: none;
  }

  #FallFlash-{{ section.id }} .fallflash__offer-inner {
    position: relative;
    max-width: 800px;
  }

  #FallFlash-{{ section.id }} .fallflash__offer-copy {
