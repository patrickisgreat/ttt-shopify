    margin: 24px auto 35px;
    color: rgba(255,255,255,.85);
    font-size: 20px;
  }

  #FallFlash-{{ section.id }} .fallflash__big-code {
    appearance: none;
    width: min(460px, 100%);
    display: grid;
    gap: 3px;
    margin: 0 auto 26px;
    padding: 24px;
    border: 1px solid rgba(255,255,255,.45);
    background: rgba(11,11,15,.18);
    color: #fff;
    cursor: pointer;
    font-family: var(--tt-body);
  }

  #FallFlash-{{ section.id }} .fallflash__big-code span {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .18em;
  }

  #FallFlash-{{ section.id }} .fallflash__big-code strong {
    font-family: var(--tt-heading);
    font-size: clamp(33px, 5vw, 50px);
    letter-spacing: .06em;
