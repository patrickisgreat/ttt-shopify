  #FallFlash-{{ section.id }} .fallflash__step p {
    color: rgba(244,242,237,.7);
    font-size: 15px;
    max-width: 340px;
  }


  /* ---------- imagery ---------- */

  #FallFlash-{{ section.id }} .fallflash__media-card {
    overflow: hidden;
  }

  #FallFlash-{{ section.id }} .fallflash__product-image,
  #FallFlash-{{ section.id }} .fallflash__media-card > .fallflash__placeholder {
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
  }

  #FallFlash-{{ section.id }} .fallflash__placeholder {
    position: relative;
    min-height: 450px;
    display: grid;
    place-items: center;
    background: rgba(0,0,0,.08);
    overflow: hidden;
  }

  #FallFlash-{{ section.id }} .fallflash__placeholder svg {
    width: 100%;
    height: 100%;
  }

  #FallFlash-{{ section.id }} .fallflash__placeholder span {
    position: absolute;
    left: 20px;
    bottom: 20px;
    padding: 7px 10px;
    background: var(--tt-black);
    color: #fff;
    font-size: 11px;
  }


  /* ---------- kit contents + math ---------- */

  #FallFlash-{{ section.id }} .fallflash__contents {
    list-style: none;
    margin: 30px 0 34px;
    padding: 0;
    border-top: 1px solid rgba(11,11,15,.18);
