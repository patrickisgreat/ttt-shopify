  #FallFlash-{{ section.id }} .fallflash__offer-fine strong {
    color: #fff;
    font-variant-numeric: tabular-nums;
  }


  /* ---------- faq ---------- */

  #FallFlash-{{ section.id }} .fallflash__faq-shell {
    display: grid;
    grid-template-columns: .7fr 1.3fr;
    gap: 80px;
  }

  #FallFlash-{{ section.id }} .fallflash__faq-item {
    border-top: 1px solid rgba(11,11,15,.18);
  }

  #FallFlash-{{ section.id }} .fallflash__faq-item:last-child {
    border-bottom: 1px solid rgba(11,11,15,.18);
  }

  #FallFlash-{{ section.id }} .fallflash__faq-q {
    margin: 0;
  }

  #FallFlash-{{ section.id }} .fallflash__faq-toggle {
    appearance: none;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin: 0;
    padding: 24px 4px 24px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
    font-family: var(--tt-heading);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
    box-shadow: none;
    min-height: 0;
  }

  #FallFlash-{{ section.id }} .fallflash__faq-toggle:hover {
    color: var(--tt-cobalt);
  }

  #FallFlash-{{ section.id }} .fallflash__faq-toggle:focus-visible {
    outline: 2px solid var(--tt-cobalt);
    outline-offset: 4px;
  }

  #FallFlash-{{ section.id }} .fallflash__faq-icon {
    position: relative;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
  }

  #FallFlash-{{ section.id }} .fallflash__faq-icon::before,
  #FallFlash-{{ section.id }} .fallflash__faq-icon::after {
    content: "";
    position: absolute;
