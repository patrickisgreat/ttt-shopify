  #FallFlash-{{ section.id }} .fallflash__big-code small {
    opacity: .7;
  }

  #FallFlash-{{ section.id }} .fallflash__offer-fine {
    margin: 20px auto 0;
    max-width: 520px;
    font-size: 12px;
    color: rgba(255,255,255,.72);
