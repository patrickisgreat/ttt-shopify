{% comment %}
  Threaditate — FALL FLASH Landing Page
  /pages/fall-sale
  Fri Sep 25 to Sun Sep 27, 2026 · 25% off any kit · Code: FALL25

  Cloned from labor-day-landing (the reference build), reskinned per
  Threaditate_Promo_Briefs_v2 chapter 5:
  - Fraunces display face for H1/H2, system fonts for everything else
  - Ochre / clay / oat / moss on ivory and black
  - Pair block replaced by the evening-ritual block
  - Single-kit math, before/after reveal block added
  - Same hook library, countdown, copy-code, sticky CTA, FAQ accordion

  URL examples:
  /pages/fall-sale?hook=evening-ritual
  /pages/fall-sale?hook=actually-finish
  /pages/fall-sale?utm_content=cooler-evenings

  Create FALL25 in Shopify Admin > Discounts (25% off order, Sep 25 to 27).
{% endcomment %}

{% liquid
  assign promo_code = section.settings.discount_code | strip

  assign default_kit = all_products['string-ring-custom-string-art-kit']

  if section.settings.product != blank
    assign cta_path = section.settings.product.url
  elsif default_kit != blank
    assign cta_path = default_kit.url
  else
    assign cta_path = routes.all_products_collection_url
  endif

  comment
    Where the buttons go.
    - checkout: two kits in the cart, code applied, straight to checkout
    - cart:     two kits in the cart, code applied, cart page first
    - product:  the PDP, code applied
    Falls back to product if we can't find a variant.
  endcomment

  if section.settings.product != blank
    assign kit = section.settings.product
  else
    assign kit = default_kit
  endif

  assign variant_id = nil
  if kit != blank and kit.selected_or_first_available_variant != blank
    assign variant_id = kit.selected_or_first_available_variant.id
  endif

  assign cta_mode = section.settings.cta_mode | default: 'product'

  comment
    Cart permalinks build a fresh checkout and ignore the /discount/ cookie,
    so the code has to ride on the permalink itself as ?discount=CODE.
    The PDP route still uses /discount/CODE?redirect= (cookie), which the
    storefront cart honors on the way to checkout.
  endcomment

  assign cta_url = cta_path
  assign single_url = cta_path

  if promo_code != blank
    assign single_url = '/discount/' | append: promo_code | append: '?redirect=' | append: cta_path
  endif

  if variant_id != nil and cta_mode == 'checkout'
    assign cta_url = '/cart/' | append: variant_id | append: ':2'
    if promo_code != blank
      assign cta_url = cta_url | append: '?discount=' | append: promo_code
    endif
  elsif variant_id != nil and cta_mode == 'cart'
    assign cta_url = '/cart/' | append: variant_id | append: ':2?storefront=true'
    if promo_code != blank
      assign cta_url = cta_url | append: '&discount=' | append: promo_code
    endif
  else
    assign cta_url = single_url
  endif

  assign kit_price = section.settings.kit_price
  assign sale_price = section.settings.sale_price
  assign savings = section.settings.savings
%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,600..700,60&display=swap" rel="stylesheet">

<section
  id="FallFlash-{{ section.id }}"
  class="fallflash"
  data-fallflash-section
  data-sale-end="{{ section.settings.sale_end | escape }}"
>

  {% if section.settings.hide_theme_chrome %}
    <script>
      document.documentElement.classList.add('threaditate-lander-active');
    </script>
  {% endif %}


  {%- comment -%}
    ============================================================
    ANNOUNCEMENT
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__announcement">
    <div class="fallflash__shell fallflash__announcement-inner">
      <span class="fallflash__announcement-text">{{ section.settings.announcement }}</span>

      {% if promo_code != blank %}
        <button
          class="fallflash__code-button"
          type="button"
          data-copy-code="{{ promo_code | escape }}"
          aria-label="Copy discount code {{ promo_code }}"
        >
          {{ promo_code }}
          <span class="fallflash__copy-label" data-copy-label>copy</span>
        </button>
      {% endif %}

      <span class="fallflash__countdown" data-countdown hidden>
        ends in <strong data-countdown-value></strong>
      </span>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    HERO
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__hero">
    {% if section.settings.hero_texture != blank %}
      <div class="fallflash__hero-texture" aria-hidden="true">
        {{
          section.settings.hero_texture
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            widths: '800, 1200, 1800, 2400',
            sizes: '100vw',
            alt: ''
        }}
      </div>
    {% endif %}
    <div class="fallflash__hero-grid fallflash__shell">

      <div class="fallflash__hero-copy">
        <p class="fallflash__eyebrow" data-hook-eyebrow>
          {{ section.settings.hero_eyebrow }}
        </p>

        <h1 class="fallflash__h1" data-hook-headline>
          {{ section.settings.hero_headline }}
        </h1>

        <p class="fallflash__hero-subhead" data-hook-subhead>
          {{ section.settings.hero_subhead }}
        </p>

        <div class="fallflash__hero-actions">
          <a
            class="fallflash__button fallflash__button--primary"
            href="{{ cta_url }}"
            data-fallflash-cta
          >
            {{ section.settings.cta_label }}
            <span aria-hidden="true">→</span>
          </a>

          {% if promo_code != blank %}
            <p class="fallflash__offer-note">
              {%- if cta_mode == 'product' -%}
                Code <strong>{{ promo_code }}</strong> is applied when you land on the kit. Any kit, any photo.
              {%- else -%}
                Two kits go in your cart with <strong>{{ promo_code }}</strong> already applied.
                <a class="fallflash__single-link" href="{{ single_url }}">Just want one?</a>
              {%- endif -%}
            </p>
          {% endif %}
        </div>

        <div class="fallflash__micro-proof">
          <span>App included</span>
          <span aria-hidden="true">·</span>
          <span>No subscription</span>
          <span aria-hidden="true">·</span>
          <span>Any photo, any kit</span>
        </div>
      </div>


      <div class="fallflash__hero-media">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              class: 'fallflash__hero-image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600, 900, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.hero_image.alt
          }}
        {% else %}
          <div class="fallflash__placeholder fallflash__placeholder--hero">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
            <span>Select your Fall Flash hero image</span>
          </div>
        {% endif %}

        <div class="fallflash__hero-card">
          <span>25% off</span>
          <strong>{{ sale_price }}</strong>
          <small>{{ promo_code }}</small>
        </div>
      </div>

    </div>
  </div>


  {%- comment -%}
    Hidden hook data. JS below message-matches the hero to ?hook= / ?utm_content=
  {%- endcomment -%}

  <div hidden data-hook-library>
    {% for block in section.blocks %}
      {% if block.type == 'hook' %}
        <span
          data-hook-record
          data-key="{{ block.settings.key | handleize }}"
          data-eyebrow="{{ block.settings.eyebrow | escape }}"
          data-headline="{{ block.settings.headline | escape }}"
          data-subhead="{{ block.settings.subhead | escape }}"
          {{ block.shopify_attributes }}
        ></span>
      {% endif %}
    {% endfor %}
  </div>


  {%- comment -%}
    ============================================================
    PROOF STRIP
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__proof">
    <div class="fallflash__proof-grid fallflash__shell">

      <div class="fallflash__proof-item">
        <strong>2,013</strong>
        <span>Kickstarter backers</span>
      </div>

      <div class="fallflash__proof-item">
        <strong>$158K</strong>
        <span>raised</span>
      </div>

      <div class="fallflash__proof-item">
        <strong>9 of 9</strong>
        <span>finishers surveyed would recommend it</span>
      </div>

      <div class="fallflash__proof-item fallflash__proof-item--quote">
        <strong>“Disconnecting from everyday stressors.”</strong>
        <span>Jessica P. · made one of her grandson</span>
      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    THE EVENING RITUAL
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__section fallflash__section--oat">
    <div class="fallflash__shell fallflash__split">

      <div class="fallflash__media-card">
        {% if section.settings.ritual_image != blank %}
          {{
            section.settings.ritual_image
            | image_url: width: 1500
            | image_tag:
              class: 'fallflash__product-image',
              loading: 'lazy',
              widths: '500, 800, 1100, 1500',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: section.settings.ritual_image.alt
          }}
        {% else %}
          <div class="fallflash__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag }}
            <span>Ritual image · 1500 x 1875</span>
          </div>
        {% endif %}
      </div>

      <div class="fallflash__section-copy">
        <p class="fallflash__eyebrow">The evening ritual</p>
        <h2 class="fallflash__h2">Lamp on. Phone down. Hands busy.</h2>
        <p class="fallflash__lead">
          Put on an album or a podcast. The app reads the next line out loud, so your eyes stay on the loom.
        </p>
        <p class="fallflash__ritual-line">An hour goes by. Then another.</p>
        <a class="fallflash__button fallflash__button--black" href="{{ cta_url }}" data-fallflash-cta>
          Make yours
          <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    HOW IT WORKS
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__section fallflash__section--black">
    <div class="fallflash__shell">

      <div class="fallflash__section-heading">
        <p class="fallflash__eyebrow fallflash__eyebrow--ochre">How it works</p>
        <h2 class="fallflash__h2 fallflash__h2--light">
          From camera roll to wall.
        </h2>
      </div>

      <div class="fallflash__steps">

        <article class="fallflash__step">
          <div class="fallflash__step-media">
            {% if section.settings.step1_image != blank %}
              {{
                section.settings.step1_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: section.settings.step1_image.alt
              }}
            {% else %}
              <div class="fallflash__placeholder">
                {{ 'image' | placeholder_svg_tag }}
                <span>App upload screen</span>
              </div>
            {% endif %}
          </div>
          <span>01</span>
          <h3>Upload a photo</h3>
          <p>Any photo from your camera roll. The app turns it into a threading sequence.</p>
        </article>

        <article class="fallflash__step">
          <div class="fallflash__step-media">
            {% if section.settings.step2_image != blank %}
              {{
                section.settings.step2_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: section.settings.step2_image.alt
              }}
            {% else %}
              <div class="fallflash__placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag }}
                <span>Hands threading</span>
              </div>
            {% endif %}
          </div>
          <span>02</span>
          <h3>Follow the voice</h3>
          <p>It tells you where to go next, line by line, at your pace. No counting.</p>
        </article>

        <article class="fallflash__step">
          <div class="fallflash__step-media">
            {% if section.settings.step3_image != blank %}
              {{
                section.settings.step3_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: section.settings.step3_image.alt
              }}
            {% else %}
              <div class="fallflash__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag }}
                <span>Finished piece on a wall</span>
              </div>
            {% endif %}
          </div>
          <span>03</span>
          <h3>Hang your piece</h3>
          <p>Your photo, made in thread. On the wall by the time the clocks change, or whenever.</p>
        </article>

      </div>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    THE KIT + THE MATH
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__section fallflash__section--oat">
    <div class="fallflash__shell fallflash__split">

      <div class="fallflash__media-card">
        {% if section.settings.product_image != blank %}
          {{
            section.settings.product_image
            | image_url: width: 1500
            | image_tag:
              class: 'fallflash__product-image',
              loading: 'lazy',
              widths: '500, 800, 1100, 1500',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: section.settings.product_image.alt
          }}
        {% else %}
          <div class="fallflash__placeholder">
            {{ 'product-1' | placeholder_svg_tag }}
            <span>Kit contents flat lay</span>
          </div>
        {% endif %}
      </div>

      <div class="fallflash__section-copy">
        <p class="fallflash__eyebrow">What's in the box</p>
        <h2 class="fallflash__h2">Everything in the box.</h2>
        <p class="fallflash__lead">
          Loom, thread, tool, stand, easel box, app. Nothing to add.
        </p>

        <ul class="fallflash__contents">
          <li>Loom and mounting hardware</li>
          <li>Thread, spool holder, threading tool</li>
          <li>Numbered guide and wooden phone stand</li>
          <li>Convertible easel box</li>
          <li>Lifetime app access, no subscription</li>
        </ul>

        <div class="fallflash__math">
          <div class="fallflash__math-row">
            <span>Kit</span>
            <strong>{{ kit_price }}</strong>
          </div>
          <div class="fallflash__math-row fallflash__math-row--deal">
            <span>With {{ promo_code }} <em>25% off</em></span>
            <strong>{{ sale_price }}</strong>
          </div>
          <div class="fallflash__math-row fallflash__math-row--total">
            <span>You pay</span>
            <strong>{{ sale_price }}</strong>
          </div>
          <p class="fallflash__math-save">You save {{ savings }}.</p>
        </div>

        <a class="fallflash__button fallflash__button--primary" href="{{ cta_url }}" data-fallflash-cta>
          {{ section.settings.cta_label }}
          <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    BEFORE / AFTER
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__section fallflash__section--ivory">
    <div class="fallflash__shell">

      <div class="fallflash__section-heading">
        <p class="fallflash__eyebrow">The reveal</p>
        <h2 class="fallflash__h2">It starts as a photo.</h2>
      </div>

      <div class="fallflash__reveal">

        <figure class="fallflash__reveal-card">
          {% if section.settings.before_image != blank %}
            {{
              section.settings.before_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 800, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: section.settings.before_image.alt
            }}
          {% else %}
            <div class="fallflash__placeholder">
              {{ 'image' | placeholder_svg_tag }}
              <span>Before · the photo · 1200 x 1500</span>
            </div>
          {% endif %}
          <figcaption>The photo</figcaption>
        </figure>

        <figure class="fallflash__reveal-card">
          {% if section.settings.after_image != blank %}
            {{
              section.settings.after_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 800, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: section.settings.after_image.alt
            }}
          {% else %}
            <div class="fallflash__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag }}
              <span>After · the piece · 1200 x 1500</span>
            </div>
          {% endif %}
          <figcaption>The piece</figcaption>
        </figure>

      </div>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    BACKER QUOTES
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__section fallflash__section--white">
    <div class="fallflash__shell">

      <p class="fallflash__eyebrow">From people who finished one</p>

      <div class="fallflash__quotes">

        <figure class="fallflash__quote fallflash__quote--featured">
          <blockquote>
            “The depth and detail of the finished work exceeded my expectation.
            It looked more true to life than the rendering in the app.”
          </blockquote>
          <figcaption>Sheryl M. · Kickstarter backer</figcaption>
        </figure>

        <figure class="fallflash__quote">
          <blockquote>
            “Incredibly rewarding and proud of finishing a project, because
            I struggle with finishing projects.”
          </blockquote>
          <figcaption>Timothy K. · Kickstarter backer</figcaption>
        </figure>

        <figure class="fallflash__quote">
          <blockquote>
            “It was easy, relaxing, and fun. I immediately wanted to do another.”
          </blockquote>
          <figcaption>Megan D. · got hers as a gift</figcaption>
        </figure>

      </div>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    OFFER
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__offer">
    <div class="fallflash__shell fallflash__offer-inner">

      <p class="fallflash__eyebrow fallflash__eyebrow--light">
        Fall flash · September 25 to 27
      </p>

      <h2 class="fallflash__h2 fallflash__h2--light">
        25% off. Three days.
      </h2>

      <p class="fallflash__offer-copy">
        Friday through Sunday, any kit. After that it is $89 again.
      </p>

      {% if promo_code != blank %}
        <button
          type="button"
          class="fallflash__big-code"
          data-copy-code="{{ promo_code | escape }}"
        >
          <span>At checkout, use</span>
          <strong>{{ promo_code }}</strong>
          <small data-copy-label>tap to copy</small>
        </button>
      {% endif %}

      <a class="fallflash__button fallflash__button--black" href="{{ cta_url }}" data-fallflash-cta>
        {{ section.settings.cta_label }}
        <span aria-hidden="true">→</span>
      </a>

      <p class="fallflash__offer-fine">
        <span data-countdown-inline hidden>Ends in <strong data-countdown-value></strong>. </span>
        Any kit, any photo. App included. Ships within one business day. 30-day returns.
        {%- if cta_mode != 'product' %}
          <a class="fallflash__single-link fallflash__single-link--light" href="{{ single_url }}">Only need one kit?</a>
        {%- endif %}
      </p>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    FAQ
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__section fallflash__section--ivory">
    <div class="fallflash__shell fallflash__faq-shell">

      <div class="fallflash__section-heading">
        <p class="fallflash__eyebrow">Good questions</p>
        <h2 class="fallflash__h2">Clear answers.</h2>
      </div>

      <div class="fallflash__faq">

        <div class="fallflash__faq-item" data-faq-item>
          <h3 class="fallflash__faq-q">
            <button type="button" class="fallflash__faq-toggle" aria-expanded="false" aria-controls="FallFlashFaq-{{ section.id }}-1" data-faq-toggle>
              <span>Do I need to know how to make string art?</span>
              <span class="fallflash__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="fallflash__faq-panel" id="FallFlashFaq-{{ section.id }}-1" data-faq-panel hidden>
            <div class="fallflash__faq-panel-inner">
              <p>
              No. The app speaks each step out loud and moves line by line at your pace.
              Most first-timers finish their first piece.
            </p>
            </div>
          </div>
        </div>

        <div class="fallflash__faq-item" data-faq-item>
          <h3 class="fallflash__faq-q">
            <button type="button" class="fallflash__faq-toggle" aria-expanded="false" aria-controls="FallFlashFaq-{{ section.id }}-2" data-faq-toggle>
              <span>Can I really use my own photo?</span>
              <span class="fallflash__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="fallflash__faq-panel" id="FallFlashFaq-{{ section.id }}-2" data-faq-panel hidden>
            <div class="fallflash__faq-panel-inner">
              <p>
              Yes. Upload a person, a pet, a place. Clear photos with a close subject and good contrast make the strongest pieces.
            </p>
            </div>
          </div>
        </div>

        <div class="fallflash__faq-item" data-faq-item>
          <h3 class="fallflash__faq-q">
            <button type="button" class="fallflash__faq-toggle" aria-expanded="false" aria-controls="FallFlashFaq-{{ section.id }}-3" data-faq-toggle>
              <span>How long does one take?</span>
              <span class="fallflash__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="fallflash__faq-panel" id="FallFlashFaq-{{ section.id }}-3" data-faq-panel hidden>
            <div class="fallflash__faq-panel-inner">
              <p>
              About 5–8 hours depending on the image. Spread it across as many sessions as
              you want. The app saves your progress.
            </p>
            </div>
          </div>
        </div>

        <div class="fallflash__faq-item" data-faq-item>
          <h3 class="fallflash__faq-q">
            <button type="button" class="fallflash__faq-toggle" aria-expanded="false" aria-controls="FallFlashFaq-{{ section.id }}-4" data-faq-toggle>
              <span>What if I mess up?</span>
              <span class="fallflash__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="fallflash__faq-panel" id="FallFlashFaq-{{ section.id }}-4" data-faq-panel hidden>
            <div class="fallflash__faq-panel-inner">
              <p>
              Keep going. Thousands of lines make the image, so a missed step disappears
              into the whole. Nothing to rip out.
            </p>
            </div>
          </div>
        </div>

        <div class="fallflash__faq-item" data-faq-item>
          <h3 class="fallflash__faq-q">
            <button type="button" class="fallflash__faq-toggle" aria-expanded="false" aria-controls="FallFlashFaq-{{ section.id }}-5" data-faq-toggle>
              <span>Is the app extra?</span>
              <span class="fallflash__faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="fallflash__faq-panel" id="FallFlashFaq-{{ section.id }}-5" data-faq-panel hidden>
            <div class="fallflash__faq-panel-inner">
              <p>No. App access comes with the kit. No subscription, ever.</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>


  {%- comment -%}
    ============================================================
    FINAL CTA
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__final">
    <div class="fallflash__shell fallflash__final-inner">
      <p>The evenings are getting longer.</p>
      <h2>Fill one.</h2>
      {% if promo_code != blank %}
        <span>25% off with code {{ promo_code }} · through Sunday, September 27</span>
      {% endif %}
      <a class="fallflash__button fallflash__button--primary" href="{{ cta_url }}" data-fallflash-cta>
        {{ section.settings.cta_label }}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>


  {%- comment -%}
    ============================================================
    MOBILE STICKY CTA
    ============================================================
  {%- endcomment -%}

  <div class="fallflash__sticky" data-fallflash-sticky>
    <div>
      <strong>25% off any kit</strong>
      <span>{{ promo_code }}</span>
    </div>
    <a href="{{ cta_url }}" data-fallflash-cta>
      {{ section.settings.cta_label }}
      <span aria-hidden="true">→</span>
    </a>
  </div>

</section>


<style>
  #FallFlash-{{ section.id }} {
    --tt-cobalt: #1450C4;
    --tt-violet: #3D3DB0;
    --tt-red: #C43D2E;
    --tt-black: #0B0B0F;
    --tt-ivory: #F4F2ED;

    /* fall additions (brief 5.2) */
    --tt-ochre: #B8742A;
    --tt-clay: #9C4A2F;
    --tt-oat: #E8DCC4;
    --tt-moss: #5B6B3F;

    --tt-heading: var(--font-heading-family, "Space Grotesk", sans-serif);
    --tt-body: var(--font-body-family, "DM Sans", sans-serif);
    --tt-display: "Fraunces", Georgia, "Times New Roman", serif;

    background: var(--tt-ivory);
    color: var(--tt-black);
    font-family: var(--tt-body);
    font-size: 18px;
    line-height: 1.6;
    overflow: clip;
  }

  #FallFlash-{{ section.id }} *,
  #FallFlash-{{ section.id }} *::before,
  #FallFlash-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #FallFlash-{{ section.id }} img {
    display: block;
    width: 100%;
  }

  #FallFlash-{{ section.id }} a {
    text-decoration: none;
  }

  #FallFlash-{{ section.id }} p {
    margin: 0;
  }

  #FallFlash-{{ section.id }} .fallflash__shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }


  /* ---------- announcement ---------- */

  #FallFlash-{{ section.id }} .fallflash__announcement {
    position: relative;
    z-index: 20;
    background: var(--tt-clay);
    color: #fff;
    font-family: var(--tt-heading);
  }

  #FallFlash-{{ section.id }} .fallflash__announcement-inner {
    min-height: 44px;
    display: flex;
    gap: 14px;
    justify-content: center;
    align-items: center;
    font-size: 13px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #FallFlash-{{ section.id }} .fallflash__code-button {
    appearance: none;
    border: 1px solid rgba(255,255,255,.5);
    background: transparent;
    color: inherit;
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
    font: inherit;
    letter-spacing: .12em;
  }

  #FallFlash-{{ section.id }} .fallflash__copy-label {
    opacity: .7;
    font-family: var(--tt-body);
    font-size: 10px;
    margin-left: 4px;
    text-transform: lowercase;
    letter-spacing: 0;
  }

  #FallFlash-{{ section.id }} .fallflash__countdown {
    opacity: .85;
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--tt-body);
  }

  #FallFlash-{{ section.id }} .fallflash__countdown strong {
    font-family: var(--tt-heading);
    font-variant-numeric: tabular-nums;
  }


  /* ---------- type ---------- */

  #FallFlash-{{ section.id }} .fallflash__eyebrow {
    margin: 0 0 14px;
    color: var(--tt-red);
    font-family: var(--tt-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #FallFlash-{{ section.id }} .fallflash__eyebrow--light {
    color: rgba(255,255,255,.85);
  }

  #FallFlash-{{ section.id }} .fallflash__eyebrow--ochre {
    color: var(--tt-ochre);
  }

  /* Fraunces for the two headline levels only; everything else stays theme fonts */
  #FallFlash-{{ section.id }} .fallflash__h1,
  #FallFlash-{{ section.id }} .fallflash__h2,
  #FallFlash-{{ section.id }} .fallflash__final h2 {
    margin: 0;
    font-family: var(--tt-display);
    font-weight: 650;
    font-variation-settings: "opsz" 96, "SOFT" 60;
    letter-spacing: -.02em;
    text-wrap: balance;
  }

  #FallFlash-{{ section.id }} .fallflash__h1 {
    font-size: clamp(44px, 6vw, 84px);
    line-height: .98;
    max-width: 720px;
  }

  #FallFlash-{{ section.id }} .fallflash__h2 {
    font-size: clamp(36px, 4.6vw, 62px);
    line-height: 1.02;
  }

  #FallFlash-{{ section.id }} .fallflash__h2--light {
    color: var(--tt-ivory);
  }

  #FallFlash-{{ section.id }} .fallflash__lead {
    font-size: clamp(20px, 2vw, 25px);
    line-height: 1.45;
  }


  /* ---------- buttons ---------- */

  #FallFlash-{{ section.id }} .fallflash__button {
    min-height: 54px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    border-radius: 999px;
    padding: 14px 26px;
    font-family: var(--tt-heading);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: .04em;
    transition: transform .18s ease, box-shadow .18s ease, background-color .18s ease;
  }

  #FallFlash-{{ section.id }} .fallflash__button:hover {
    transform: translateY(-2px);
  }

  #FallFlash-{{ section.id }} .fallflash__button--primary {
    background: var(--tt-red);
    color: #fff;
    box-shadow: 0 12px 32px rgba(196, 61, 46, .22);
  }

  #FallFlash-{{ section.id }} .fallflash__button--ivory {
    background: var(--tt-ivory);
    color: var(--tt-black);
  }

  #FallFlash-{{ section.id }} .fallflash__button--black {
    background: var(--tt-black);
    color: #fff;
  }


  /* ---------- hero ---------- */

  #FallFlash-{{ section.id }} .fallflash__hero {
    position: relative;
    background:
      linear-gradient(180deg, var(--tt-oat) 0%, var(--tt-ivory) 70%);
  }

  /* thread-line texture, barely there */
  #FallFlash-{{ section.id }} .fallflash__hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        -32deg,
        rgba(11,11,15,.045) 0 1px,
        transparent 1px 22px
      );
    pointer-events: none;
    mask-image: linear-gradient(180deg, rgba(0,0,0,.9), transparent 75%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,.9), transparent 75%);
  }

  #FallFlash-{{ section.id }} .fallflash__hero-texture {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: {{ section.settings.hero_texture_opacity | default: 12 | divided_by: 100.0 }};
    {%- if section.settings.hero_texture_fade %}
    mask-image: linear-gradient(180deg, rgba(0,0,0,1), transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,1), transparent 85%);
    {%- endif %}
  }

  #FallFlash-{{ section.id }} .fallflash__hero-texture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #FallFlash-{{ section.id }} .fallflash__hero-grid {
    position: relative;
    min-height: min(820px, calc(100vh - 44px));
    display: grid;
    grid-template-columns: 1fr .9fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
    padding-block: 64px;
  }

  #FallFlash-{{ section.id }} .fallflash__hero-copy {
    position: relative;
    z-index: 2;
  }

  #FallFlash-{{ section.id }} .fallflash__hero-subhead {
    max-width: 600px;
    margin: 26px 0 0;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.5;
  }

  #FallFlash-{{ section.id }} .fallflash__hero-actions {
    margin-top: 30px;
  }

  #FallFlash-{{ section.id }} .fallflash__offer-note {
    margin: 14px 0 0;
    font-size: 14px;
    max-width: 420px;
    color: rgba(11,11,15,.75);
  }

  #FallFlash-{{ section.id }} .fallflash__single-link {
    color: var(--tt-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: 4px;
  }

  #FallFlash-{{ section.id }} .fallflash__single-link--light {
    color: #fff;
  }

  #FallFlash-{{ section.id }} .fallflash__micro-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
    color: rgba(11,11,15,.68);
    font-size: 13px;
  }

  #FallFlash-{{ section.id }} .fallflash__hero-media {
    position: relative;
    min-height: 650px;
  }

  /* ochre slab behind the photo, the one loud thing in the hero */
  #FallFlash-{{ section.id }} .fallflash__hero-media::before {
    content: "";
    position: absolute;
    top: 28px;
    right: -28px;
    bottom: -28px;
    left: 28px;
    background: var(--tt-ochre);
    z-index: 0;
  }

  #FallFlash-{{ section.id }} .fallflash__hero-image,
  #FallFlash-{{ section.id }} .fallflash__hero-media > .fallflash__placeholder {
    position: relative;
    z-index: 1;
    height: 650px;
    object-fit: cover;
    border-radius: 2px;
  }

  #FallFlash-{{ section.id }} .fallflash__hero-card {
    position: absolute;
    z-index: 2;
    left: -28px;
    bottom: 36px;
    width: 170px;
    min-height: 170px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 22px;
    background: var(--tt-cobalt);
    color: #fff;
    box-shadow: 0 18px 50px rgba(20,80,196,.25);
  }

  #FallFlash-{{ section.id }} .fallflash__hero-card span {
    font-size: 13px;
  }

  #FallFlash-{{ section.id }} .fallflash__hero-card strong {
    display: block;
    margin: 3px 0;
    font-family: var(--tt-heading);
    font-size: 30px;
    line-height: 1;
  }

  #FallFlash-{{ section.id }} .fallflash__hero-card small {
    font-weight: 700;
    letter-spacing: .12em;
  }


  /* ---------- proof ---------- */

  #FallFlash-{{ section.id }} .fallflash__proof {
    border-block: 1px solid rgba(11,11,15,.13);
    background: #fff;
  }

  #FallFlash-{{ section.id }} .fallflash__proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.6fr;
  }

  #FallFlash-{{ section.id }} .fallflash__proof-item {
    min-height: 112px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 22px;
    border-right: 1px solid rgba(11,11,15,.13);
  }

  #FallFlash-{{ section.id }} .fallflash__proof-item:last-child {
    border-right: 0;
  }

  #FallFlash-{{ section.id }} .fallflash__proof-item strong {
    font-family: var(--tt-heading);
    font-size: 21px;
    line-height: 1.2;
  }

  #FallFlash-{{ section.id }} .fallflash__proof-item--quote strong {
    color: var(--tt-cobalt);
    font-size: 18px;
    letter-spacing: -.01em;
  }

  #FallFlash-{{ section.id }} .fallflash__proof-item span {
    font-size: 13px;
    color: rgba(11,11,15,.6);
  }


  /* ---------- sections ---------- */

  #FallFlash-{{ section.id }} .fallflash__section {
    position: relative;
    padding-block: clamp(78px, 10vw, 145px);
  }

  #FallFlash-{{ section.id }} .fallflash__section--ivory { background: var(--tt-ivory); }
  #FallFlash-{{ section.id }} .fallflash__section--white { background: #fff; }
  #FallFlash-{{ section.id }} .fallflash__section--oat   { background: var(--tt-oat); }

  #FallFlash-{{ section.id }} .fallflash__section--black {
    background: var(--tt-black);
    color: var(--tt-ivory);
  }

  #FallFlash-{{ section.id }} .fallflash__section-heading {
    max-width: 720px;
    margin-bottom: 55px;
  }

  #FallFlash-{{ section.id }} .fallflash__section-heading > p:last-child {
    max-width: 620px;
    margin-top: 20px;
    font-size: 19px;
  }

  #FallFlash-{{ section.id }} .fallflash__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(50px, 7vw, 100px);
    align-items: center;
  }

  #FallFlash-{{ section.id }} .fallflash__section-copy > p {
    max-width: 620px;
  }

  #FallFlash-{{ section.id }} .fallflash__section-copy .fallflash__lead {
    margin-top: 22px;
  }


  /* ---------- ritual ---------- */

  #FallFlash-{{ section.id }} .fallflash__ritual-line {
    margin-top: 16px;
    font-size: 17px;
    color: rgba(11,11,15,.7);
  }

  #FallFlash-{{ section.id }} .fallflash__section-copy .fallflash__button {
    margin-top: 34px;
  }


  /* ---------- reveal (before / after) ---------- */

  #FallFlash-{{ section.id }} .fallflash__reveal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  #FallFlash-{{ section.id }} .fallflash__reveal-card {
    margin: 0;
  }

  #FallFlash-{{ section.id }} .fallflash__reveal-card img,
  #FallFlash-{{ section.id }} .fallflash__reveal-card .fallflash__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    height: auto;
    min-height: 0;
    object-fit: cover;
  }

  #FallFlash-{{ section.id }} .fallflash__reveal-card figcaption {
    margin-top: 12px;
    color: var(--tt-moss);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }


  /* ---------- steps ---------- */

  #FallFlash-{{ section.id }} .fallflash__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    border-top: 1px solid rgba(255,255,255,.22);
