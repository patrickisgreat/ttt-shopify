{{ 'section-cta-banner.css' | asset_url | stylesheet_tag }}

<div
  id="{{ section.id }}"
  class="cta-banner pt pb sm-pt sm-pb"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>
  <div class="cta-banner__bg" aria-hidden="true"></div>

  <div class="cta-banner__inner container">
    <div class="cta-banner__content text-align-center">

      {%- if section.settings.heading != blank -%}
        <h2 class="cta-banner__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="cta-banner__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        
          <a href="{{ section.settings.button_link | default: '#' }}"
          class="cta-banner__btn"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.caption != blank -%}
        <p class="cta-banner__caption">{{ section.settings.caption }}</p>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTA Banner",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create Your String Ring"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Turn a meaningful photo into custom string art — guided, calming, and designed to be finished."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Your String Ring →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (below button)",
      "default": "No experience needed. Everything included."
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 240,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 120
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 240,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "CTA Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}