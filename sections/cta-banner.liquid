{{ 'section-cta-banner.css' | asset_url | stylesheet_tag }}

<div
  id="{{ section.id }}"
  class="screen-fit cta-banner cta-banner--{{ section.settings.style | default: 'cobalt' }} pt pb sm-pt sm-pb"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>
  <div class="cta-banner__bg" aria-hidden="true"></div>

  <div class="cta-banner__inner container">
    <div class="cta-banner__content text-align-center">

      {%- comment -%}
        Three photos that follow the headline: a memory (the original photo),
        a meditation (someone threading), a piece (someone with the finished
        piece). Empty slots show only inside the Theme Editor, never to
        customers.
      {%- endcomment -%}
      {%- liquid
        assign show_trio = false
        if section.settings.image_memory != blank or section.settings.image_meditation != blank or section.settings.image_piece != blank
          assign show_trio = true
        endif
        if request.design_mode
          assign show_trio = true
        endif
      -%}
      {%- if show_trio -%}
        <div class="cta-banner__trio">
          {%- for slot in (1..3) -%}
            {%- liquid
              case slot
                when 1
                  assign img = section.settings.image_memory
                  assign label = section.settings.memory_label
                when 2
                  assign img = section.settings.image_meditation
                  assign label = section.settings.meditation_label
                else
                  assign img = section.settings.image_piece
                  assign label = section.settings.piece_label
              endcase
            -%}
            {%- if img != blank or request.design_mode -%}
              <figure class="cta-banner__trio-item">
                <div class="cta-banner__trio-media">
                  {%- if img != blank -%}
                    {{ img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240, 400, 600', sizes: '(min-width: 768px) 220px, 30vw', alt: label }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'cta-banner__placeholder' }}
                  {%- endif -%}
                </div>
                {%- if label != blank -%}
                  <figcaption class="cta-banner__trio-label">{{ label | escape }}</figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="cta-banner__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="cta-banner__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        
          <a href="{{ section.settings.button_link | default: '#' }}"
          class="cta-banner__btn"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.caption != blank -%}
        <p class="cta-banner__caption">{{ section.settings.caption }}</p>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTA Banner",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "info": "Use Ivory when this banner sits directly above or below another cobalt section.",
      "default": "cobalt",
      "options": [
        {
          "value": "cobalt",
          "label": "Cobalt"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "black",
          "label": "Black"
        }
      ]
    },
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "paragraph",
      "content": "Three photos above the heading, in order: the memory, the meditation, the piece. Empty slots only show here in the editor."
    },
    {
      "type": "image_picker",
      "id": "image_memory",
      "label": "Memory",
      "info": "The original photo, e.g. framed on a mantle."
    },
    {
      "type": "text",
      "id": "memory_label",
      "label": "Memory label",
      "default": "A memory"
    },
    {
      "type": "image_picker",
      "id": "image_meditation",
      "label": "Meditation",
      "info": "Someone threading the loom."
    },
    {
      "type": "text",
      "id": "meditation_label",
      "label": "Meditation label",
      "default": "A meditation"
    },
    {
      "type": "image_picker",
      "id": "image_piece",
      "label": "Piece",
      "info": "Someone with the finished piece."
    },
    {
      "type": "text",
      "id": "piece_label",
      "label": "Piece label",
      "default": "A piece"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create your Threaditate"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Turn a meaningful photo into custom string art: guided, calming, and designed to be finished."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my kit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (below button)",
      "default": "No experience needed. Everything included."
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 240,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 120
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 240,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "CTA Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}