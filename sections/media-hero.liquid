{{ 'section-media-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_bg_image = false
  if section.settings.background_image != blank
    assign has_bg_image = true
  endif
-%}

<div
  id="{{ section.id }}"
  class="media-hero-section pt pb sm-pt sm-pb color-{{ section.settings.color_scheme }}{% if has_bg_image %} media-hero-section--has-bg{% endif %}"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>

  {%- if has_bg_image -%}
    <div class="media-hero__bg-image">
      {%- render 'img',
        lazyload: false,
        wrapped: false,
        src: section.settings.background_image
      -%}
    </div>
    <div class="media-hero__bg-overlay" aria-hidden="true"></div>
  {%- else -%}
    <div class="media-hero__bg-gradient" aria-hidden="true"></div>
  {%- endif -%}

  <div class="media-hero__inner container">

    <div class="media-hero__header text-align-center">
      {%- if section.settings.heading != blank -%}
        <h2 class="media-hero__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="media-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.foreground_image != blank -%}
      <div class="media-hero__media-wrapper">
        <div class="media-hero__glow" aria-hidden="true"></div>
        <div class="media-hero__media sm-br-img">
          {%- render 'img',
            lazyload: false,
            wrapped: false,
            src: section.settings.foreground_image
          -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.caption != blank -%}
      <p class="media-hero__caption text-align-center">{{ section.settings.caption }}</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Media Hero",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "default",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Set Up Your String Ring"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to go from box to first string — step by step."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (below image)",
      "default": "No experience needed • Take it at your own pace"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Fills the entire section. If left empty, a CSS gradient is used instead."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Darken the background image to improve text readability."
    },
    {
      "type": "image_picker",
      "id": "foreground_image",
      "label": "Foreground (floating) image",
      "info": "Displayed centered on top of the background. Recommended 16:9 landscape image."
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Media Hero",
      "category": "Custom"
    }
  ]
}
{% endschema %}