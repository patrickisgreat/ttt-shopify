<div id="{{ section.id }}"
  class="screen-fit pt pb sm-pt sm-pb container{% if section.settings.enable_full_width %} edge-to-edge{% endif %}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="apps-section__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {% for block in section.blocks %}
    {% render block %}
  {% endfor %}
</div>

{%- if section.settings.heading != blank -%}
  {%- style -%}
    .apps-section__heading {
      margin: 0 auto 24px;
      max-width: 820px;
      text-align: center;
      font-family: var(--font-heading-family);
      font-weight: var(--font-heading-weight);
      font-size: 2.8rem;
      line-height: var(--font-heading-line-height);
      letter-spacing: var(--font-heading-letter-spacing);
      color: var(--color-foreground);
    }
    @media only screen and (min-width: 768px) {
      .apps-section__heading { font-size: 3.6rem; margin-bottom: 32px; }
    }
    /* The section prints the heading; hide the app widget's own (Judge.me's
       truncates to one line with an ellipsis on phones). */
    #{{ section.id }} .jdgm-header { display: none !important; }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.apps.name",
  "class": "app-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Shown above the app in the theme's heading style. When set, the app's own heading is hidden."
    },
    {
      "type": "checkbox",
      "id": "enable_full_width",
      "label": "t:sections.layout.section_width.full_width",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.headers.desktop_layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.layout.margin_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.layout.margin_bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.headers.mobile_layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.layout.margin_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.layout.margin_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.name"
    }
  ]
}
{% endschema %}
