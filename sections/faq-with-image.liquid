{{ 'section-faq-with-image.css' | asset_url | stylesheet_tag }}

<div
  id="{{ section.id }}"
  class="faq-section container pt pb sm-pt sm-pb color-{{ section.settings.color_scheme }}"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>

  <div class="faq__header text-align-center">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="faq__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="faq__body">

    <div class="faq__accordion-col">
      {%- if section.blocks.size > 0 -%}
        <div class="faq__accordion" id="faq-accordion-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq_item' -%}
              <div
                class="faq__item{% if forloop.first %} is-open{% endif %}"
                {{ block.shopify_attributes }}
              >
                <button
                  class="faq__question"
                  aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="faq-answer-{{ section.id }}-{{ forloop.index }}"
                >
                  <span>{{ block.settings.question }}</span>
                  <span class="faq__icon" aria-hidden="true">
                    <svg class="faq__icon-chevron-right" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M7.5 4.5L13 10L7.5 15.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <svg class="faq__icon-chevron-up" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M4.5 13L10 7.5L15.5 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </button>
                <div
                  class="faq__answer"
                  id="faq-answer-{{ section.id }}-{{ forloop.index }}"
                  role="region"
                >
                  <div class="faq__answer-inner">
                    {{ block.settings.answer }}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="faq__cta">
          
            <a href="{{ section.settings.button_link | default: '#' }}"
            class="btn btn--secondary"
          >
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="faq__image-col">
      {%- if section.settings.image != blank -%}
        <div class="faq__image sm-br-img">
          {%- render 'img',
            lazyload: true,
            wrapped: false,
            src: section.settings.image
          -%}
        </div>
      {%- else -%}
        <div class="faq__image faq__image--placeholder sm-br-img">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
  (function() {
    const accordion = document.getElementById('faq-accordion-{{ section.id }}');
    if (!accordion) return;

    accordion.addEventListener('click', function(e) {
      const btn = e.target.closest('.faq__question');
      if (!btn) return;

      const item = btn.closest('.faq__item');
      const isOpen = item.classList.contains('is-open');

      // Close all
      accordion.querySelectorAll('.faq__item').forEach(function(el) {
        el.classList.remove('is-open');
        el.querySelector('.faq__question').setAttribute('aria-expanded', 'false');
      });

      // Open clicked (unless it was already open)
      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  })();
</script>

