{{ 'section-reviews-wall.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Reviews wall: a rating summary and a masonry grid of review cards, filled
  in the browser from Judge.me's public review feed (the same feed its own
  carousel widgets use). Pinned reviews come first, then newest. Text is
  inserted with textContent, never as HTML.
{%- endcomment -%}
{%- liquid
  assign wall_product = section.settings.product
  if wall_product == blank
    assign wall_product = all_products['string-ring-custom-string-art-kit']
  endif
  assign rating = wall_product.metafields.reviews.rating.value
  assign rating_count = wall_product.metafields.reviews.rating_count.value | default: 0
-%}

<div
  id="{{ section.id }}"
  class="screen-fit reviews-wall reviews-wall--{{ section.settings.style }} pt pb sm-pt sm-pb"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
  data-reviews-wall
  data-shop="{{ shop.permanent_domain }}"
  data-url="{{ shop.url | url_encode }}"
  data-min-rating="{{ section.settings.min_rating }}"
  data-max="{{ section.settings.max_reviews }}"
  data-hide-anonymous="{{ section.settings.hide_anonymous }}"
>
  <div class="reviews-wall__inner container">
    <div class="reviews-wall__header">
      <div class="reviews-wall__summary">
        {%- if section.settings.heading != blank -%}
          <h2 class="reviews-wall__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if rating != blank and rating_count > 0 -%}
          <p class="reviews-wall__score">
            <span class="reviews-wall__stars reviews-wall__stars--lg" style="--pct: {{ rating.rating | divided_by: rating.scale_max | times: 100 }}%;" role="img" aria-label="{{ rating.rating | round: 1 }} out of {{ rating.scale_max }} stars"></span>
            <span><strong>{{ rating.rating | round: 1 }}</strong> from {{ rating_count }} {% if rating_count == 1 %}review{% else %}reviews{% endif %}</span>
          </p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="reviews-wall__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="reviews-wall__grid" data-reviews-grid aria-live="polite"></div>

    <template data-review-card>
      <article class="reviews-wall__card">
        <header class="reviews-wall__card-head">
          <span class="reviews-wall__name" data-name></span>
          <span class="reviews-wall__verified" data-verified hidden>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="8" fill="currentColor"/><path d="m4.8 8.2 2.1 2.1 4.3-4.6" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Verified
          </span>
        </header>
        <time class="reviews-wall__date" data-date></time>
        <span class="reviews-wall__stars" data-stars role="img"></span>
        <p class="reviews-wall__title" data-title hidden></p>
        <p class="reviews-wall__body" data-body></p>
        {%- if section.settings.show_product -%}
          <footer class="reviews-wall__product">
            {%- if wall_product.featured_image -%}
              {{ wall_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 48, height: 48, alt: '' }}
            {%- endif -%}
            <span>{{ wall_product.title | escape }}</span>
          </footer>
        {%- endif -%}
      </article>
    </template>

    {%- if request.design_mode -%}
      <p class="reviews-wall__empty" data-reviews-empty hidden>No reviews match these settings yet. Reviews come from Judge.me.</p>
    {%- endif -%}
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('{{ section.id }}');
    if (!root || root.dataset.loaded) return;
    root.dataset.loaded = 'true';
    const grid = root.querySelector('[data-reviews-grid]');
    const tpl = root.querySelector('[data-review-card]');
    const min = Number(root.dataset.minRating || 4);
    const max = Number(root.dataset.max || 9);
    const hideAnon = root.dataset.hideAnonymous === 'true';
    const params = new URLSearchParams({
      carousel_type: 'cards', reviews_selection: 'all', star_rating: 'all', max_reviews: '100',
      display_order: 'most_recent', shop_domain: root.dataset.shop, platform: 'shopify',
      url: decodeURIComponent(root.dataset.url), primary_language: 'en'
    });
    // On laptops and desktops the wall is one screen: cards that would push it
    // past the bottom are hidden (they stay in the swipe row on phones).
    const fit = () => {
      const cards = [...grid.children];
      cards.forEach((c) => { c.hidden = false; });
      if (window.matchMedia('(max-width: 767px)').matches) return;
      const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 0;
      const screen = window.innerHeight - header;
      for (let i = cards.length - 1; i >= 3 && root.offsetHeight > screen + 1; i--) cards[i].hidden = true;
    };
    const fmt = new Intl.DateTimeFormat(undefined, { month: 'numeric', day: 'numeric', year: 'numeric' });

    fetch('https://cdn.judge.me/reviews/reviews_for_carousel?' + params)
      .then((r) => r.ok ? r.json() : Promise.reject(r.status))
      .then((data) => {
        const reviews = (data.reviews || [])
          .filter((r) => r.rating >= min && (r.body || '').trim() !== '')
          .filter((r) => !(hideAnon && r.is_anonymous_reviewer))
          .sort((a, b) => (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0) || new Date(b.created_at) - new Date(a.created_at))
          .slice(0, max);
        if (!reviews.length) { root.querySelector('[data-reviews-empty]')?.removeAttribute('hidden'); if (!root.querySelector('[data-reviews-empty]')) root.closest('.shopify-section').hidden = true; return; }
        for (const r of reviews) {
          const card = tpl.content.firstElementChild.cloneNode(true);
          card.querySelector('[data-name]').textContent = r.reviewer_name || 'A maker';
          if (r.verified_buyer) card.querySelector('[data-verified]').hidden = false;
          const date = card.querySelector('[data-date]');
          date.dateTime = r.created_at; date.textContent = fmt.format(new Date(r.created_at));
          const stars = card.querySelector('[data-stars]');
          stars.style.setProperty('--pct', (r.rating / 5 * 100) + '%');
          stars.setAttribute('aria-label', r.rating + ' out of 5 stars');
          if (r.title) { const t = card.querySelector('[data-title]'); t.textContent = r.title; t.hidden = false; }
          card.querySelector('[data-body]').textContent = r.body;
          grid.appendChild(card);
        }
        fit();
        window.addEventListener('resize', fit, { passive: true });
      })
      .catch(() => { root.closest('.shopify-section').hidden = !root.querySelector('[data-reviews-empty]'); });
  })();
</script>

{% schema %}
{
  "name": "Reviews wall",
  "class": "section--reviews-wall",
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "default": "cobalt", "options": [
      { "value": "cobalt", "label": "Cobalt" },
      { "value": "lavender", "label": "Lavender" },
      { "value": "ivory", "label": "Ivory" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made by people like you." },
    { "type": "product", "id": "product", "label": "Rating and photo from product", "info": "Defaults to the Threaditate kit." },
    { "type": "header", "content": "Reviews" },
    { "type": "paragraph", "content": "Reviews come from Judge.me. Pinned reviews show first, then the newest. Pin or hide reviews in the Judge.me admin." },
    { "type": "range", "id": "min_rating", "label": "Lowest star rating shown", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "max_reviews", "label": "Reviews shown", "min": 3, "max": 18, "step": 1, "default": 9 },
    { "type": "checkbox", "id": "hide_anonymous", "label": "Hide anonymous reviews", "default": true },
    { "type": "checkbox", "id": "show_product", "label": "Show product on each card", "default": true },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "info": "Leave empty for no button." },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "header", "content": "Desktop layout" },
    { "type": "range", "id": "md_padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "md_padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Padding bottom", "default": 64 },
    { "type": "header", "content": "Mobile layout" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "presets": [{ "name": "Reviews wall" }]
}
{% endschema %}
