{{ 'section-icon-row.css' | asset_url | stylesheet_tag }}

<div
  id="{{ section.id }}"
  class="icon-row-section pt pb sm-pt sm-pb color-{{ section.settings.color_scheme }}"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>
  <div class="icon-row__inner container">

    {%- if section.settings.heading != blank -%}
      <h2 class="icon-row__title text-align-center">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="icon-row__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'icon_item' -%}
            <div class="icon-row__item" {{ block.shopify_attributes }}>

              <div class="icon-row__icon">
                {%- if block.settings.icon_image != blank -%}
                  <img
                    src="{{ block.settings.icon_image | img_url: '120x120' }}"
                    alt="{{ block.settings.label }}"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                {%- elsif block.settings.icon_svg != blank -%}
                  {{ block.settings.icon_svg }}
                {%- else -%}
                  <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="28" stroke="currentColor" stroke-width="2" stroke-dasharray="6 4"/>
                  </svg>
                {%- endif -%}
              </div>

              {%- if block.settings.label != blank -%}
                <p class="icon-row__label">{{ block.settings.label }}</p>
              {%- endif -%}

            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Icon Row",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "default",
      "label": "Color scheme",
      "info": "Use a dark color scheme to match the design."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What You'll Do"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "name": "Icon Item",
      "type": "icon_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image",
          "info": "Upload a white PNG or SVG icon. Overrides SVG code below."
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Icon SVG code",
          "info": "Paste raw <svg> code here. Icons should use currentColor for stroke/fill so they inherit the text color."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Assemble your loom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Row",
      "category": "Custom",
      "blocks": [
        {
          "type": "icon_item",
          "settings": {
            "label": "Assemble your loom"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "label": "Upload a photo and generate your guide"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "label": "Start stringing with confidence"
          }
        }
      ]
    }
  ]
}
{% endschema %}