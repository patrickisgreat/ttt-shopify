{{ 'section-icon-row-dark.css' | asset_url | stylesheet_tag }}

<div
  id="{{ section.id }}"
  class="icon-row-dark pt pb sm-pt sm-pb"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>
  <div class="icon-row-dark__inner container">

    {%- if section.blocks.size > 0 -%}
      <div class="icon-row-dark__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'icon_item' -%}
            <div class="icon-row-dark__item" {{ block.shopify_attributes }}>

              <div class="icon-row-dark__icon">
                {%- if block.settings.icon_image != blank -%}
                  <img
                    src="{{ block.settings.icon_image | img_url: '120x120' }}"
                    alt="{{ block.settings.title }}"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                {%- elsif block.settings.icon_svg != blank -%}
                  {{ block.settings.icon_svg }}
                {%- else -%}
                  <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="8" y="8" width="40" height="40" rx="8" stroke="white" stroke-width="1.5"/>
                  </svg>
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="icon-row-dark__title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="icon-row-dark__description">{{ block.settings.description }}</p>
              {%- endif -%}

            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Icon Row Dark",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "name": "Icon Item",
      "type": "icon_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image",
          "info": "Upload a white PNG or SVG. Overrides SVG code below."
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Icon SVG code",
          "info": "Paste raw <svg> code. Use stroke='white' or fill='white' for visibility on dark background."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Thoughtful Support"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We believe help should feel calm and encouraging."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Row Dark",
      "category": "Custom",
      "blocks": [
        {
          "type": "icon_item",
          "settings": {
            "title": "Thoughtful Support",
            "description": "We believe help should feel calm and encouraging."
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "title": "No Pressure",
            "description": "There's no such thing as a silly question."
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "title": "Human Responses",
            "description": "You'll hear from a real person — not a bot."
          }
        }
      ]
    }
  ]
}
{% endschema %}