        { "type": "slide", "settings": { "caption": "Lorem ipsum dolor sit amet consectetur adipiscing elit semper dalar elementum tempus hac tellus libero accumsan." } },
        { "type": "slide", "settings": { "caption": "Lorem ipsum dolor sit amet consectetur adipiscing elit semper dalar elementum tempus hac tellus libero accumsan." } },
        { "type": "slide", "settings": { "caption": "Lorem ipsum dolor sit amet consectetur adipiscing elit semper dalar elementum tempus hac tellus libero accumsan." } },
        { "type": "slide", "settings": { "caption": "Lorem ipsum dolor sit amet consectetur adipiscing elit semper dalar elementum tempus hac tellus libero accumsan." } }
      ]
    }
  ]
}
