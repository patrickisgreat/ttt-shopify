{%- comment -%}
  Star rating plus "4.5 from 12 reviews", read from the product's review
  metafields (Judge.me keeps them current). Renders nothing when the product
  has no reviews yet.

  ** PARAMETERS **
  product   => REQUIRED | product object
  class     => OPTIONAL | string | extra class on the wrapper, e.g. 'hero-dark__rating'
{%- endcomment -%}
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
-%}
{%- if rating != blank and rating_count > 0 -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {%- liquid
    assign rating_decimal = 0
    assign decimal = rating.rating | modulo: 1
    if decimal >= 0.3 and decimal <= 0.7
      assign rating_decimal = 0.5
    elsif decimal > 0.7
      assign rating_decimal = 1
    endif
  -%}
  <p class="rating-summary {{ class }}">
    <span class="rating" role="img" aria-label="{{ rating.rating | round: 1 }} out of {{ rating.scale_max }} stars">
      <span aria-hidden="true" class="rating-star" style="--rating: {{ rating.rating | floor }}; --rating-max: {{ rating.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
    </span>
    <span class="rating-summary__text">
      <strong>{{ rating.rating | round: 1 }}</strong> from {{ rating_count }} {% if rating_count == 1 %}review{% else %}reviews{% endif %}
    </span>
  </p>
{%- endif -%}
