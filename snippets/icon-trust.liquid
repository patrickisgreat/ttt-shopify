{%- comment -%}
  Small brand line icons for trust strips and rows. 24x24 viewBox, currentColor.
  Usage: {% render 'icon-trust', icon: 'patent' %}
  Icons: kits, patent, app, ship, guarantee, gift, clock
{%- endcomment -%}
{%- case icon -%}
  {%- when 'kits' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M2.5 20c.6-3.6 3.3-5.5 6.5-5.5s5.9 1.9 6.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M15.5 5.2a3.5 3.5 0 0 1 0 5.6M17 14.6c2.4.5 4 2.3 4.5 5.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'patent' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="6" stroke="currentColor" stroke-width="1.6"/><path d="m9.5 9 1.8 1.8 3.2-3.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="m8.5 14.2-1.5 7 5-2.5 5 2.5-1.5-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'app' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><rect x="6" y="2.5" width="12" height="19" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M10 5.5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="18" r="1" fill="currentColor"/><path d="M20.5 9c1.3 1.8 1.3 4.2 0 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'ship' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M3 8.5 12 4l9 4.5v9L12 22l-9-4.5v-9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 8.5 12 13l9-4.5M12 13v9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'guarantee' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M12 3 4.5 6v5.5c0 4.5 3.2 7.8 7.5 9.5 4.3-1.7 7.5-5 7.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m9 12 2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'gift' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><rect x="3.5" y="9" width="17" height="11.5" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 13h17M12 9v11.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 9c-1.5-3-4-4.5-5.5-3s0 3.5 5.5 3Zm0 0c1.5-3 4-4.5 5.5-3s0 3.5-5.5 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
