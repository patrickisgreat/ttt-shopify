    {% liquid
      assign og_title = page_title | default: shop.name
      assign og_url = canonical_url | default: request.origin
      assign og_type = 'website'
      assign og_description = page_description | default: settings.share_description | default: shop.description | default: shop.name

      comment
        Social crawlers (Slack, iMessage, Facebook, X) show no card without an
        image, so fall back to the theme's default share image whenever the page
        itself has none — the homepage and every /pages/* route included.
      endcomment
      assign og_image = page_image | default: settings.share_image
      assign og_image_alt = og_image.alt | default: og_title

      assign og_image_width = og_image.width
      assign og_image_height = og_image.height
      if og_image_width > 1200
        assign og_image_height = og_image_height | times: 1200 | divided_by: og_image_width
        assign og_image_width = 1200
      endif

      comment
        Crawlers reject relative image URLs, so make it absolute — image_url
        returns a protocol-relative path.
      endcomment
      if og_image != blank
        capture og_image_url
          echo og_image | image_url: width: og_image_width | prepend: 'https:'
        endcapture
      endif

      if request.page_type == 'product'
        assign og_type = 'product'
      elsif request.page_type == 'article'
        assign og_type = 'article'
      elsif request.page_type == 'password'
        assign og_url = request.origin
      endif
    -%}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ og_url }}">
    <meta property="og:title" content="{{ og_title | escape }}">
    <meta property="og:type" content="{{ og_type }}">
    <meta property="og:description" content="{{ og_description | escape }}">

    {% if og_image != blank -%}
    <meta property="og:image" content="{{ og_image_url }}">
    <meta property="og:image:secure_url" content="{{ og_image_url }}">
    <meta property="og:image:width" content="{{ og_image_width }}">
    <meta property="og:image:height" content="{{ og_image_height }}">
    <meta property="og:image:alt" content="{{ og_image_alt | escape }}">
    {%- endif %}

    {% if request.page_type == 'product' -%}
    <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
    <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
    <meta property="og:availability" content="{% if product.available %}instock{% else %}oos{% endif %}">
    {% endif -%}

    {% if settings.social_twitter_link != blank -%}
      <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
    {% endif -%}
    <meta name="twitter:card" content="{% if og_image != blank %}summary_large_image{% else %}summary{% endif %}">
    <meta name="twitter:title" content="{{ og_title | escape }}">
    <meta name="twitter:description" content="{{ og_description | escape }}">
    {% if og_image != blank -%}
    <meta name="twitter:image" content="{{ og_image_url }}">
    <meta name="twitter:image:alt" content="{{ og_image_alt | escape }}">
    {%- endif %}
